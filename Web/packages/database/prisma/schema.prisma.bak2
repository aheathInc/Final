// A-health platform — Prisma schema
//
// Derived from packages/api/openapi/a-health-api-v1.yaml. Every model here
// backs a schema in that contract, or exists to support a cross-cutting
// guarantee the contract makes (idempotency, offline sync, audit).
//
// Conventions
// -----------
// Prisma models are PascalCase and fields camelCase; the database uses
// snake_case via @map / @@map. The API layer serialises to snake_case JSON,
// matching the contract.
//
// Every mutable model carries `version` and `updatedAt`. These are not
// optional niceties — offline sync and conflict detection are built on them,
// and retrofitting them onto a live clinical database is painful. They are
// here from migration one.
//
// `clinician_id` throughout the API refers to ClinicianProfile.id, not
// User.id. Patient references are PatientProfile.id for the same reason: a
// dependant has a profile but no user account.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  patient
  clinician
  pharmacist
  lab_technician
  dispatcher
  facility_admin
  platform_admin
  researcher
  dispatcher_supervisor
}

enum UserStatus {
  active
  suspended
  pending_verification
  deactivated
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum Sex {
  male
  female
  other
}

enum LanguageCode {
  sw
  en
  fr
  ha
  am
}

enum Channel {
  app
  sms
  ussd
  voice
  web
}

enum Specialty {
  general_practice
  internal_medicine
  paediatrics
  obstetrics_gynaecology
  surgery
  oncology
  psychiatry
  dermatology
  other
}

enum UrgencyLevel {
  routine
  urgent
  emergency
}

enum ConsultationStatus {
  pending
  offered
  matched
  in_progress
  completed
  escalated
  cancelled
}

enum ConsultationModality {
  chat
  voice
  video
  async
}

enum CareThreadStatus {
  open
  closed
}

enum CareThreadOutcome {
  recovered
  referred_out
  lost_to_follow_up
  deceased
}

enum AppointmentStatus {
  booked
  started
  completed
  cancelled
  no_show
}

enum OfferStatus {
  offered
  accepted
  declined
  expired
}

enum PrescriptionStatus {
  active
  completed
  discontinued
}

enum AdherenceStatus {
  taken
  missed
  delayed
  unreported
}

enum FollowUpFrequency {
  daily
  twice_daily
  weekly
  custom
}

enum FollowUpStatus {
  active
  completed
  cancelled
}

enum FollowUpOutcome {
  recovered
  escalated
  lost_to_follow_up
}

enum CheckInStatus {
  scheduled
  responded
  missed
}

enum FacilityType {
  hospital
  clinic
  pharmacy
  transport_partner
  laboratory
  imaging_centre
}

enum AttachmentType {
  voice_note
  image
  document
}

enum ChangeOp {
  create
  update
  delete
}

enum ConsentScope {
  full_history
  current_thread
  medications_only
  investigations_only
  emergency_minimum
}

enum ConsentGranteeType {
  clinician
  facility
  researcher
  emergency_responder
}

enum RecordType {
  lab_result
  imaging
  pathology
  discharge_summary
  vaccination
  prior_history
  referral_letter
  other
}

enum NotificationStatus {
  queued
  sent
  delivered
  failed
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String       @id @default(uuid()) @db.Uuid
  phoneNumber       String       @unique @map("phone_number") @db.VarChar(20)
  role              UserRole
  status            UserStatus   @default(pending_verification)
  fullName          String?      @map("full_name") @db.VarChar(150)
  email             String?      @unique @db.VarChar(150)
  // Argon2id. Null for patient accounts, which are OTP-only.
  passwordHash      String?      @map("password_hash") @db.VarChar(255)
  mfaSecret         String?      @map("mfa_secret") @db.VarChar(255)
  preferredLanguage LanguageCode @default(sw) @map("preferred_language")

  /// Consecutive failed password attempts. Reset to zero on any success.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  /// Set when the counter trips. Checked before the password is even compared,
  /// so a locked account costs an attacker nothing to discover and gains them
  /// nothing to keep trying.
  lockedUntil      DateTime? @map("locked_until")

  patientProfile   PatientProfile?     @relation("PatientUser")
  clinicianProfile ClinicianProfile?
  guardedProfiles  PatientProfile[]    @relation("Guardian")
  refreshTokens    RefreshToken[]
  messagesSent     Message[]
  notifications    NotificationLog[]
  idempotency      IdempotencyRecord[]

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  aiConversations  AiConversation[]
  incidentReports  IncidentReport[]
  researchQueries  ResearchQuery[]
  emergencyReports EmergencyRequest[] @relation("EmergencyReporter")
  realtimeTickets  RealtimeTicket[]

  @@index([status, role])
  @@index([updatedAt])
  @@map("users")
}

model PatientProfile {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation("PatientUser", fields: [userId], references: [id], onDelete: Cascade)

  // Set for dependants, who have a profile but no login of their own.
  guardianUserId String? @map("guardian_user_id") @db.Uuid
  guardian       User?   @relation("Guardian", fields: [guardianUserId], references: [id], onDelete: Restrict)

  fullName          String    @map("full_name") @db.VarChar(150)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  sex               Sex?
  chronicConditions Json      @default("[]") @map("chronic_conditions")
  allergies         Json      @default("[]")
  bloodType         String?   @map("blood_type") @db.VarChar(5)
  defaultLat        Float?    @map("default_lat")
  defaultLng        Float?    @map("default_lng")
  // Coarse geography for de-identified aggregation. Never joined to an id in
  // an analytics view.
  regionCode        String?   @map("region_code") @db.VarChar(20)

  careThreads    CareThread[]
  consultations  ConsultationRequest[]
  appointments   Appointment[]
  prescriptions  Prescription[]
  adherenceLogs  AdherenceLog[]
  followUpCycles FollowUpCycle[]
  consents       PatientConsent[]
  medicalRecords MedicalRecord[]

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  riskScores           RiskScore[]
  screeningInvitations ScreeningInvitation[]
  vaccinations         Vaccination[]
  devices              Device[]
  emergencyRequests    EmergencyRequest[]
  investigationOrders  InvestigationOrder[]
  familyMemberships    FamilyMember[]
  insuranceMemberships InsuranceMembership[]

  @@index([guardianUserId])
  @@index([regionCode])
  @@index([updatedAt])
  @@map("patient_profiles")
}

model ClinicianProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  facilityId String?   @map("facility_id") @db.Uuid
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  licenseNumber      String             @unique @map("license_number") @db.VarChar(50)
  specialty          Specialty
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason")
  verificationDocs   Json               @default("[]") @map("verification_docs")
  languagesSpoken    Json               @default("[]") @map("languages_spoken")

  isAvailable    Boolean   @default(false) @map("is_available")
  availableUntil DateTime? @map("available_until")
  // Denormalised count of in-progress consultations. Maintained by the
  // consultation service; the ranking query reads it on every routing decision
  // and cannot afford a COUNT(*) per candidate.
  currentLoad    Int       @default(0) @map("current_load")
  ratingAvg      Decimal?  @map("rating_avg") @db.Decimal(3, 2)

  slots                 Slot[]
  appointments          Appointment[]
  offers                ConsultationOffer[]
  assignedConsultations ConsultationRequest[] @relation("AssignedClinician")
  primaryCareThreads    CareThread[]          @relation("PrimaryClinician")
  signedNotes           ConsultationNote[]    @relation("SignedBy")
  referredNotes         ConsultationNote[]    @relation("ReferredSpecialist")
  prescriptions         Prescription[]
  followUpCycles        FollowUpCycle[]
  reviewedCheckIns      CheckIn[]
  grantedConsents       PatientConsent[]      @relation("ConsentGrantee")
  recordedRecords       MedicalRecord[]       @relation("RecordedBy")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Families this clinician carries under the family-doctor tier. Bounded, so
  /// the promise has a delivery mechanism rather than being a slogan.
  familyLoad    Int @default(0) @map("family_load")
  maxFamilyLoad Int @default(0) @map("max_family_load")

  discussions            Discussion[]
  discussionReplies      DiscussionReply[]
  communityMemberships   CommunityMembership[]
  secondOpinionsAsked    SecondOpinion[]       @relation("OpinionRequester")
  secondOpinionsAnswered SecondOpinion[]       @relation("OpinionAnswerer")
  ratings                ConsultationRating[]
  familyGpAssignments    FamilyAssignment[]    @relation("FamilyGp")
  familyObgynAssignments FamilyAssignment[]    @relation("FamilyObgyn")
  investigationOrders    InvestigationOrder[]
  incidentReports        IncidentReport[]

  // The routing engine's candidate lookup. Partial index in a migration:
  //   WHERE verification_status = 'verified' AND is_available = true
  @@index([verificationStatus, isAvailable, specialty])
  @@index([updatedAt])
  @@map("clinician_profiles")
}

model Facility {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(200)
  type         FacilityType
  lat          Float?
  lng          Float?
  regionCode   String?      @map("region_code") @db.VarChar(20)
  contactPhone String?      @map("contact_phone") @db.VarChar(20)
  isActive     Boolean      @default(true) @map("is_active")

  clinicians     ClinicianProfile[]
  consents       PatientConsent[]
  sourcedRecords MedicalRecord[]    @relation("RecordSource")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// How deeply this facility is connected. `none` is honest and common: a
  /// facility with no integration must report no queue rather than a guess.
  integrationLevel IntegrationLevel @default(none) @map("integration_level")

  departments         Department[]
  transportUnits      TransportUnit[]
  investigationOrders InvestigationOrder[]
  vaccinations        Vaccination[]
  incidentReports     IncidentReport[]
  emergencyArrivals   EmergencyRequest[]   @relation("EmergencyDestination")

  @@index([regionCode, type])
  @@map("facilities")
}

model OtpChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  phoneNumber     String    @map("phone_number") @db.VarChar(20)
  // The code itself is never stored in plaintext.
  codeHash        String    @map("code_hash") @db.VarChar(255)
  deliveryChannel Channel   @default(sms) @map("delivery_channel")
  purpose         String    @db.VarChar(40)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5) @map("max_attempts")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([phoneNumber, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String  @unique @map("token_hash") @db.VarChar(255)
  // Rotation lineage. Presenting an already-used token revokes the whole
  // family — the standard response to a stolen refresh token.
  familyId  String  @map("family_id") @db.Uuid
  deviceId  String? @map("device_id") @db.VarChar(128)

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model Slot {
  id          String               @id @default(uuid()) @db.Uuid
  clinicianId String               @map("clinician_id") @db.Uuid
  clinician   ClinicianProfile     @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  startsAt    DateTime             @map("starts_at")
  durationMin Int                  @map("duration_minutes")
  modality    ConsultationModality @default(chat)
  isBooked    Boolean              @default(false) @map("is_booked")

  appointment Appointment?

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clinicianId, startsAt])
  @@index([clinicianId, startsAt, isBooked])
  @@map("slots")
}

model Appointment {
  id     String @id @default(uuid()) @db.Uuid
  slotId String @unique @map("slot_id") @db.Uuid
  slot   Slot   @relation(fields: [slotId], references: [id], onDelete: Restrict)

  careThreadId String?     @map("care_thread_id") @db.Uuid
  careThread   CareThread? @relation(fields: [careThreadId], references: [id], onDelete: Restrict)

  patientProfileId String           @map("patient_profile_id") @db.Uuid
  patient          PatientProfile   @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  clinicianId      String           @map("clinician_id") @db.Uuid
  clinician        ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Restrict)

  consultation ConsultationRequest?

  startsAt        DateTime             @map("starts_at")
  durationMin     Int                  @map("duration_minutes")
  modality        ConsultationModality @default(chat)
  reason          String?
  status          AppointmentStatus    @default(booked)
  cancelledReason String?              @map("cancelled_reason")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([patientProfileId, startsAt])
  @@index([clinicianId, startsAt])
  @@index([status, startsAt])
  @@index([updatedAt])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Care threads and consultations
// ---------------------------------------------------------------------------

model CareThread {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patient          PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  primaryClinicianId String?           @map("primary_clinician_id") @db.Uuid
  primaryClinician   ClinicianProfile? @relation("PrimaryClinician", fields: [primaryClinicianId], references: [id], onDelete: Restrict)

  status        CareThreadStatus   @default(open)
  reasonSummary String?            @map("reason_summary") @db.VarChar(300)
  outcome       CareThreadOutcome?
  outcomeNotes  String?            @map("outcome_notes")

  // Denormalised for the thread list view, which is read far more than written.
  latestConsultationId  String? @map("latest_consultation_id") @db.Uuid
  openConsultationCount Int     @default(0) @map("open_consultation_count")

  /// The follow-up cycle currently running on this thread, if any. Kept on
  /// the thread so the timeline view does not have to query for it.
  activeFollowUpCycleId String? @map("active_follow_up_cycle_id") @db.Uuid

  consultations  ConsultationRequest[]
  notes          ConsultationNote[]
  messages       Message[]
  appointments   Appointment[]
  prescriptions  Prescription[]
  followUpCycles FollowUpCycle[]
  checkIns       CheckIn[]
  consents       PatientConsent[]
  medicalRecords MedicalRecord[]

  openedAt  DateTime  @default(now()) @map("opened_at")
  closedAt  DateTime? @map("closed_at")
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  investigationOrders InvestigationOrder[]
  secondOpinions      SecondOpinion[]
  discussions         Discussion[]
  aiConversations     AiConversation[]

  @@index([patientProfileId, status])
  @@index([primaryClinicianId, status])
  @@index([updatedAt])
  @@map("care_threads")
}

model ConsultationRequest {
  id           String     @id @default(uuid()) @db.Uuid
  careThreadId String     @map("care_thread_id") @db.Uuid
  careThread   CareThread @relation(fields: [careThreadId], references: [id], onDelete: Cascade)

  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patient          PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  assignedClinicianId String?           @map("assigned_clinician_id") @db.Uuid
  assignedClinician   ClinicianProfile? @relation("AssignedClinician", fields: [assignedClinicianId], references: [id], onDelete: Restrict)

  // Referral chain within one thread.
  referredFromId String?               @map("referred_from_consultation_id") @db.Uuid
  referredFrom   ConsultationRequest?  @relation("Referral", fields: [referredFromId], references: [id], onDelete: Restrict)
  referrals      ConsultationRequest[] @relation("Referral")

  appointmentId String?      @unique @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  channel            Channel
  modality           ConsultationModality @default(chat)
  symptomText        String?              @map("symptom_text")
  structuredSymptoms Json                 @default("[]") @map("structured_symptoms")
  voiceNoteKey       String?              @map("voice_note_key")
  requestLat         Float?               @map("request_lat")
  requestLng         Float?               @map("request_lng")

  urgencyLevel      UrgencyLevel @map("urgency_level")
  // Exact rule set that produced urgencyLevel. A triage decision must stay
  // explainable against the rules that were live when it was made.
  triageRuleVersion String       @map("triage_rule_version") @db.VarChar(40)

  status          ConsultationStatus @default(pending)
  slaDeadlineAt   DateTime           @map("sla_deadline_at")
  escalationCount Int                @default(0) @map("escalation_count")

  offers         ConsultationOffer[]
  note           ConsultationNote?
  messages       Message[]
  prescriptions  Prescription[]
  followUpCycles FollowUpCycle[]

  // Distinct from createdAt: when the patient actually acted, which may
  // precede arrival at the server by hours when offline.
  clientCreatedAt DateTime? @map("client_created_at")
  acceptedAt      DateTime? @map("accepted_at")
  completedAt     DateTime? @map("completed_at")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rating          ConsultationRating?
  insuranceClaims InsuranceClaim[]
  incidentReports IncidentReport[]

  // Powers the live queue view and the SLA escalation worker.
  @@index([status, urgencyLevel, slaDeadlineAt])
  @@index([assignedClinicianId, status])
  @@index([careThreadId, createdAt])
  @@index([updatedAt])
  @@map("consultation_requests")
}

// Which clinicians a request was pushed to, and what happened. Not in the API
// contract as a resource, but `GET /queue?scope=offered` cannot be answered
// without it, and it is the audit trail for why a case waited.
model ConsultationOffer {
  id             String              @id @default(uuid()) @db.Uuid
  consultationId String              @map("consultation_id") @db.Uuid
  consultation   ConsultationRequest @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  clinicianId String           @map("clinician_id") @db.Uuid
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)

  rankScore     Decimal     @map("rank_score") @db.Decimal(6, 4)
  rankWeights   Json        @map("rank_weights")
  status        OfferStatus @default(offered)
  declineReason String?     @map("decline_reason") @db.VarChar(60)

  offeredAt   DateTime  @default(now()) @map("offered_at")
  respondedAt DateTime? @map("responded_at")
  expiresAt   DateTime  @map("expires_at")

  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([consultationId, clinicianId])
  @@index([clinicianId, status, expiresAt])
  @@map("consultation_offers")
}

model ConsultationNote {
  id             String              @id @default(uuid()) @db.Uuid
  consultationId String              @unique @map("consultation_id") @db.Uuid
  consultation   ConsultationRequest @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  careThreadId String     @map("care_thread_id") @db.Uuid
  careThread   CareThread @relation(fields: [careThreadId], references: [id], onDelete: Cascade)

  diagnosisText     String @map("diagnosis_text")
  diagnosisCodes    Json   @default("[]") @map("diagnosis_codes")
  adviceText        String @map("advice_text")
  redFlagsDiscussed Json   @default("[]") @map("red_flags_discussed")

  referredSpecialistId String?           @map("referred_specialist_id") @db.Uuid
  referredSpecialist   ClinicianProfile? @relation("ReferredSpecialist", fields: [referredSpecialistId], references: [id], onDelete: Restrict)

  // Stamped server-side after checking the signer is verified. Never accepted
  // from the client.
  signedByClinicianId String           @map("signed_by_clinician_id") @db.Uuid
  signedBy            ClinicianProfile @relation("SignedBy", fields: [signedByClinicianId], references: [id], onDelete: Restrict)
  signedAt            DateTime         @map("signed_at")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([careThreadId, signedAt])
  @@index([signedByClinicianId])
  @@map("consultation_notes")
}

model Message {
  id           String     @id @default(uuid()) @db.Uuid
  careThreadId String     @map("care_thread_id") @db.Uuid
  careThread   CareThread @relation(fields: [careThreadId], references: [id], onDelete: Cascade)

  // Null for messages exchanged between consultations, during follow-up.
  consultationId String?              @map("consultation_id") @db.Uuid
  consultation   ConsultationRequest? @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  senderUserId String @map("sender_user_id") @db.Uuid
  sender       User   @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  body           String?
  attachmentKey  String?         @map("attachment_key")
  attachmentType AttachmentType? @map("attachment_type")
  deliveredVia   Channel         @default(app) @map("delivered_via")
  readAt         DateTime?       @map("read_at")

  clientCreatedAt DateTime? @map("client_created_at")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([careThreadId, createdAt])
  @@index([consultationId, createdAt])
  @@index([updatedAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Medication
// ---------------------------------------------------------------------------

model Prescription {
  id           String     @id @default(uuid()) @db.Uuid
  careThreadId String     @map("care_thread_id") @db.Uuid
  careThread   CareThread @relation(fields: [careThreadId], references: [id], onDelete: Cascade)

  consultationId String              @map("consultation_id") @db.Uuid
  consultation   ConsultationRequest @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patient          PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  prescribedById String           @map("prescribed_by_id") @db.Uuid
  prescribedBy   ClinicianProfile @relation(fields: [prescribedById], references: [id], onDelete: Restrict)

  status PrescriptionStatus @default(active)

  items         PrescriptionItem[]
  adherenceLogs AdherenceLog[]

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dispenseCodes     DispenseCode[]
  dispensingRecords DispensingRecord[]

  @@index([patientProfileId, status])
  @@index([updatedAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid()) @db.Uuid
  prescriptionId String       @map("prescription_id") @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicationName  String  @map("medication_name") @db.VarChar(150)
  dosage          String  @db.VarChar(50)
  frequencyPerDay Int     @map("frequency_per_day")
  durationDays    Int     @map("duration_days")
  instructions    String?

  adherenceLogs AdherenceLog[]

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dispensingItems DispensingItem[]

  @@index([prescriptionId])
  @@map("prescription_items")
}

// One row per expected dose, generated when the prescription is created.
// High write volume — a candidate for monthly partitioning at scale.
model AdherenceLog {
  id                 String           @id @default(uuid()) @db.Uuid
  prescriptionItemId String           @map("prescription_item_id") @db.Uuid
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)

  prescriptionId String       @map("prescription_id") @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patient          PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  // Denormalised so a reminder renders without a second fetch — it must work
  // from a cached row with no connectivity.
  medicationName String @map("medication_name") @db.VarChar(150)
  dosage         String @db.VarChar(50)

  scheduledAt    DateTime        @map("scheduled_at")
  reportedStatus AdherenceStatus @default(unreported) @map("reported_status")
  reportedAt     DateTime?       @map("reported_at")
  note           String?         @db.VarChar(500)
  channel        Channel?

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([patientProfileId, scheduledAt])
  @@index([prescriptionId, reportedStatus])
  @@index([scheduledAt, reportedStatus])
  @@index([updatedAt])
  @@map("adherence_logs")
}

// ---------------------------------------------------------------------------
// Follow-up
// ---------------------------------------------------------------------------

model FollowUpCycle {
  id           String     @id @default(uuid()) @db.Uuid
  careThreadId String     @map("care_thread_id") @db.Uuid
  careThread   CareThread @relation(fields: [careThreadId], references: [id], onDelete: Cascade)

  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patient          PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  clinicianId String           @map("clinician_id") @db.Uuid
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Restrict)

  sourceConsultationId String              @map("source_consultation_id") @db.Uuid
  sourceConsultation   ConsultationRequest @relation(fields: [sourceConsultationId], references: [id], onDelete: Restrict)

  frequency        FollowUpFrequency
  customCron       String?           @map("custom_cron") @db.VarChar(120)
  questionnaireKey String?           @map("questionnaire_key") @db.VarChar(80)
  // Clinician-set thresholds. A response outside these bounds is flagged as a
  // deviation — computed server-side, never sent by the client.
  recoveryCriteria Json              @default("{}") @map("recovery_criteria")

  startDate DateTime         @map("start_date") @db.Date
  endDate   DateTime         @map("end_date") @db.Date
  status    FollowUpStatus   @default(active)
  outcome   FollowUpOutcome?

  openDeviationCount Int @default(0) @map("open_deviation_count")

  checkIns CheckIn[]

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([patientProfileId, status])
  @@index([clinicianId, status])
  @@index([updatedAt])
  @@map("follow_up_cycles")
}

model CheckIn {
  id              String        @id @default(uuid()) @db.Uuid
  followUpCycleId String        @map("follow_up_cycle_id") @db.Uuid
  followUpCycle   FollowUpCycle @relation(fields: [followUpCycleId], references: [id], onDelete: Cascade)

  careThreadId String     @map("care_thread_id") @db.Uuid
  careThread   CareThread @relation(fields: [careThreadId], references: [id], onDelete: Cascade)

  scheduledAt DateTime      @map("scheduled_at")
  status      CheckInStatus @default(scheduled)
  questions   Json          @default("[]")
  responses   Json?

  isDeviation      Boolean @default(false) @map("is_deviation")
  deviationReasons Json    @default("[]") @map("deviation_reasons")

  reviewedById String?           @map("reviewed_by_id") @db.Uuid
  reviewedBy   ClinicianProfile? @relation(fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?         @map("reviewed_at")

  respondedAt DateTime? @map("responded_at")
  channel     Channel?

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([followUpCycleId, scheduledAt])
  // Drives the scheduler that dispatches due check-ins.
  @@index([status, scheduledAt])
  // Drives the clinician's deviation review queue.
  @@index([isDeviation, reviewedAt])
  @@index([updatedAt])
  @@map("check_ins")
}

// ---------------------------------------------------------------------------
// Consent and patient records
// ---------------------------------------------------------------------------

// Carried forward from the original schema. The blueprint promises patients
// control who sees which parts of their record; this is where that promise is
// enforced. Read authorisation checks this table, not just the caller's role.
//
// Emergency access is deliberately possible without a prior grant — a patient
// unconscious in an ambulance cannot consent — but it is recorded as
// `breakGlass` and always writes an audit entry for later review.
model PatientConsent {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patient          PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  granteeType        ConsentGranteeType @map("grantee_type")
  // Null when the grant is to a whole class rather than one party — for
  // example any clinician treating an active thread.
  granteeClinicianId String?            @map("grantee_clinician_id") @db.Uuid
  granteeClinician   ClinicianProfile?  @relation("ConsentGrantee", fields: [granteeClinicianId], references: [id], onDelete: Cascade)
  granteeFacilityId  String?            @map("grantee_facility_id") @db.Uuid
  granteeFacility    Facility?          @relation(fields: [granteeFacilityId], references: [id], onDelete: Cascade)

  // Scoped to one thread when the patient wants to share a single episode
  // rather than a lifetime of history.
  careThreadId String?     @map("care_thread_id") @db.Uuid
  careThread   CareThread? @relation(fields: [careThreadId], references: [id], onDelete: Cascade)

  scope      ConsentScope
  allowed    Boolean      @default(true)
  breakGlass Boolean      @default(false) @map("break_glass")
  reason     String?      @db.VarChar(500)

  grantedAt DateTime  @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([patientProfileId, allowed, revokedAt])
  @@index([granteeClinicianId, allowed])
  @@index([updatedAt])
  @@map("patient_consents")
}

// Carried forward from the original schema, and it fills a real gap: lab
// results, imaging, vaccination history and anything captured at registration
// belong to the patient, not to any one consultation. A thread link is
// optional so a result can be filed against the episode that ordered it.
model MedicalRecord {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  patient          PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  careThreadId String?     @map("care_thread_id") @db.Uuid
  careThread   CareThread? @relation(fields: [careThreadId], references: [id], onDelete: Restrict)

  recordType RecordType @map("record_type")
  title      String     @db.VarChar(200)
  body       String?
  // Structured payload where the source system provides one — analyte values,
  // reference ranges, and so on.
  structured Json       @default("{}")

  attachmentKey  String?         @map("attachment_key")
  attachmentType AttachmentType? @map("attachment_type")

  sourceFacilityId String?   @map("source_facility_id") @db.Uuid
  sourceFacility   Facility? @relation("RecordSource", fields: [sourceFacilityId], references: [id], onDelete: Restrict)

  recordedById String?           @map("recorded_by_id") @db.Uuid
  recordedBy   ClinicianProfile? @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  // Set when a result crosses a threshold requiring urgent review, per the
  // contract's critical-result alerting.
  isCritical     Boolean   @default(false) @map("is_critical")
  acknowledgedAt DateTime? @map("acknowledged_at")

  recordedAt DateTime @map("recorded_at")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([patientProfileId, recordedAt])
  @@index([careThreadId, recordType])
  @@index([isCritical, acknowledgedAt])
  @@index([updatedAt])
  @@map("medical_records")
}

// ---------------------------------------------------------------------------
// Cross-cutting infrastructure
// ---------------------------------------------------------------------------

// Backs the Idempotency-Key header. The first response against a key is stored
// and replayed on every retry, which is what stops offline sync from creating
// duplicate clinical records.
model IdempotencyRecord {
  key    String  @id @db.VarChar(64)
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  method      String @db.VarChar(10)
  path        String @db.VarChar(300)
  // Guards against the same key being reused for a different request body.
  requestHash String @map("request_hash") @db.VarChar(64)

  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  // Held while the first request is still in flight, so concurrent retries
  // wait rather than both executing.
  lockedAt       DateTime? @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_records")
}

// Backs GET /sync/changes. A dedicated log rather than scanning every table:
// it gives ordered delivery across entities and, critically, tombstones — a
// client that was offline during a deletion still learns to drop the row.
model ChangeLog {
  seq              BigInt   @id @default(autoincrement())
  entity           String   @db.VarChar(60)
  entityId         String   @map("entity_id") @db.Uuid
  op               ChangeOp
  version          Int
  // Denormalised visibility keys so the sync query can filter without joining
  // back to each source table.
  patientProfileId String?  @map("patient_profile_id") @db.Uuid
  clinicianId      String?  @map("clinician_id") @db.Uuid
  careThreadId     String?  @map("care_thread_id") @db.Uuid

  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([patientProfileId, seq])
  @@index([clinicianId, seq])
  @@index([entity, entityId])
  @@map("change_log")
}

// Append-only, hash-chained. Each row carries the hash of its predecessor, so
// any tampering breaks the chain and is detectable by replay. This is the
// tamper-evident audit trail PDPA and clinical governance require, without a
// distributed ledger.
model AuditLog {
  seq         BigInt  @id @default(autoincrement())
  actorUserId String? @map("actor_user_id") @db.Uuid

  action     String  @db.VarChar(100)
  entityType String  @map("entity_type") @db.VarChar(60)
  entityId   String? @map("entity_id") @db.Uuid
  // Required for administrative PHI access — no silent browsing of records.
  reason     String? @db.VarChar(500)
  ipAddress  String? @map("ip_address") @db.VarChar(45)
  requestId  String? @map("request_id") @db.VarChar(64)
  metadata   Json    @default("{}")

  prevHash String? @map("prev_hash") @db.VarChar(64)
  hash     String  @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model NotificationLog {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel     Channel
  templateKey String             @map("template_key") @db.VarChar(100)
  payload     Json               @default("{}")
  status      NotificationStatus @default(queued)
  providerRef String?            @map("provider_ref") @db.VarChar(120)
  failureCode String?            @map("failure_code") @db.VarChar(60)
  attempts    Int                @default(0)

  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  /// Hold the notification until this time. An in-app message that the
  /// recipient reads within the grace window is never sent again over SMS —
  /// without this the platform would charge itself, and annoy the patient,
  /// for every message they had already seen.
  deliverAfter DateTime? @map("deliver_after")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("notification_logs")
}

// ===========================================================================
// Enums for the expanded domains
// ===========================================================================

enum IntegrationLevel {
  none
  partial
  full
  platform_operated
}

enum AiAudience {
  patient
  clinician
}

enum AiMessageRole {
  user
  assistant
  system
}

enum AiModelStatus {
  active
  shadow
  retired
  not_deployed
}

enum AiInferenceKind {
  chat
  triage
  drug_interaction
  transcription
  synthesis
  risk_score
  image_analysis
  anomaly_detection
  forecast
}

enum EmergencyScale {
  individual
  mass_casualty
}

enum EmergencyCategory {
  medical
  trauma
  obstetric
  road_traffic
  fire
  other
}

enum EmergencySource {
  patient_app
  bystander
  ussd
  sms
  voice
  wearable
  vehicle_sensor
  facility
}

enum EmergencyStatus {
  reported
  triaged
  dispatched
  en_route
  arrived
  resolved
  cancelled
}

enum EmergencyOutcome {
  transported
  treated_on_scene
  refused_care
  false_alarm
  deceased
}

enum TransportStatus {
  available
  dispatched
  en_route
  at_scene
  transporting
  out_of_service
}

enum TransportCapability {
  basic
  advanced
  neonatal
  mass_casualty
}

enum DeviceType {
  wearable_watch
  vehicle_sensor
  bp_monitor
  glucometer
  pulse_oximeter
}

enum DeviceStatus {
  active
  revoked
  lost
}

enum TelemetryMetric {
  heart_rate
  spo2
  systolic
  diastolic
  glucose
  temperature
  steps
  motion
  impact_g
}

enum DeviceAlertType {
  fall_detected
  collision_detected
  heart_rate_abnormal
  spo2_low
  no_motion
  manual_trigger
}

enum DeviceAlertStatus {
  raised
  acknowledged
  escalated
  false_positive
  resolved
}

enum AlertRecipientType {
  treating_clinician
  family_doctor
  emergency_department
  relative
  patient
}

enum RiskBand {
  low
  moderate
  high
  very_high
}

enum InvitationStatus {
  pending
  accepted
  declined
  deferred
  completed
  expired
}

enum VaccinationStatus {
  due
  overdue
  administered
  contraindicated
}

enum StockStatus {
  in_stock
  low_stock
  out_of_stock
  unknown
}

enum DispensingStatus {
  pending
  partial
  complete
  cancelled
}

enum InvestigationType {
  laboratory
  imaging
  pathology
  point_of_care
}

enum InvestigationStatus {
  ordered
  scheduled
  collected
  resulted
  acknowledged
  cancelled
}

enum ResultFlag {
  normal
  low
  high
  critical_low
  critical_high
}

enum SecondOpinionStatus {
  open
  claimed
  answered
  withdrawn
}

enum ContentFormat {
  article
  audio
  video
  interactive
  sms_series
}

enum EducationCategory {
  communicable
  non_communicable
  maternal_child
  mental_health
  prevention
  nutrition
}

enum ReadingLevel {
  basic
  intermediate
  advanced
}

enum SubscriptionTier {
  none
  family_basic
  family_plus
}

enum FamilyRelationship {
  head
  spouse
  child
  parent
  sibling
  dependant
  other
}

enum ResearchQueryStatus {
  queued
  running
  complete
  failed
  rejected
}

enum GeoLevel {
  ward
  district
  region
  national
  continental
}

enum MembershipStatus {
  active
  lapsed
  suspended
  unknown
}

enum ClaimStatus {
  submitted
  under_review
  approved
  rejected
  paid
}

enum IncidentCategory {
  clinical_care
  misconduct
  medication_error
  delayed_response
  data_privacy
  ai_error
  other
