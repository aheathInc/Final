{
  "name": "@a-health/api",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./openapi/a-health-api-v1.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^2.46.1",
    "@stoplight/prism-cli": "^5.16.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "lint": "redocly lint openapi/a-health-api-v1.yaml",
    "mock": "prism mock openapi/a-health-api-v1.yaml --port 4010 --errors",
    "docs": "redocly preview-docs openapi/a-health-api-v1.yaml",
    "generate": "openapi-typescript openapi/a-health-api-v1.yaml -o src/generated/schema.d.ts",
    "build": "pnpm run generate"
  },
  "files": [
    "openapi",
    "src"
  ]
}
