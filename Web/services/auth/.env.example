NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://ahealth:replace-with-local-password@localhost:55432/ahealth_dev?schema=public
JWT_SECRET=replace-with-at-least-32-random-local-characters
JWT_ISSUER=a-health
JWT_AUDIENCE=a-health-api
# Local-only: explicit gate plus independent OTP echo opt-in. Plaintext console logging stays off.
AUTH_LOCAL_OTP_MODE=true
OTP_ECHO_IN_RESPONSE=true
OTP_LOG_TO_CONSOLE=false

# Optional local synthetic seed inputs; required only when running the corresponding seed.
AHP_SEED_ADMIN_PASSWORD=<set-local-admin-seed-password>
AHP_SEED_CLINICIAN_PASSWORD=<set-local-clinician-seed-password>
