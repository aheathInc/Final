# Copy to .env, then replace every secret placeholder with a private local value.
# scripts/configure-local.ps1 reads the database and JWT values through masked prompts.
NODE_ENV=development
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql://ahealth:replace-with-local-password@127.0.0.1:55432/ahealth_dev?schema=public
TEST_DATABASE_URL=postgresql://ahealth:replace-with-local-password@127.0.0.1:55432/ahealth_dev?schema=ahp_test
JWT_SECRET=replace-with-at-least-32-random-local-characters
JWT_ISSUER=a-health
JWT_AUDIENCE=a-health-api
GATEWAY_SHARED_SECRET=replace-with-at-least-16-random-local-characters
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-local-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200,http://localhost:3300,http://127.0.0.1:3000,http://127.0.0.1:3100,http://127.0.0.1:3200,http://127.0.0.1:3300

# Local-only provider modes. These are clearly labeled simulations and do not
# send SMS, contact mobile-money providers, or call external AI services.
AUTH_LOCAL_OTP_MODE=true
OTP_ECHO_IN_RESPONSE=true
OTP_LOG_TO_CONSOLE=false
SMS_PROVIDER=console
MOBILE_MONEY_PROVIDER=console
WEBHOOK_SECRET_MPESA=replace-with-a-private-local-random-key
WEBHOOK_SECRET_TIGO_PESA=replace-with-a-private-local-random-key
WEBHOOK_SECRET_AIRTEL_MONEY=replace-with-a-private-local-random-key
CHAT_PROVIDER=stub
TRANSCRIBE_PROVIDER=stub

# Service URLs for the web apps, gateway and offline sync client.
AUTH_SERVICE_URL=http://127.0.0.1:4001
PATIENT_SERVICE_URL=http://127.0.0.1:4002
DOCTOR_SERVICE_URL=http://127.0.0.1:4003
APPOINTMENT_SERVICE_URL=http://127.0.0.1:4004
CONSULTATION_SERVICE_URL=http://127.0.0.1:4005
MESSAGING_SERVICE_URL=http://127.0.0.1:4006
FOLLOWUP_SERVICE_URL=http://127.0.0.1:4007
AI_SERVICE_URL=http://127.0.0.1:4009
EMERGENCY_SERVICE_URL=http://127.0.0.1:4010
PHARMACY_SERVICE_URL=http://127.0.0.1:4011
PAYMENT_SERVICE_URL=http://127.0.0.1:4012
DIAGNOSTICS_SERVICE_URL=http://127.0.0.1:4013
QUALITY_SERVICE_URL=http://127.0.0.1:4014
FAMILIES_SERVICE_URL=http://127.0.0.1:4015
EDUCATION_SERVICE_URL=http://127.0.0.1:4016
NETWORK_SERVICE_URL=http://127.0.0.1:4017
INSURANCE_SERVICE_URL=http://127.0.0.1:4018
RESEARCH_SERVICE_URL=http://127.0.0.1:4019
SURVEILLANCE_SERVICE_URL=http://127.0.0.1:4020
SYNC_SERVICE_URL=http://127.0.0.1:4022
DEVICES_SERVICE_URL=http://127.0.0.1:4023
PREVENTION_SERVICE_URL=http://127.0.0.1:4024
FACILITIES_SERVICE_URL=http://127.0.0.1:4025

# Synthetic account password is generated into the gitignored .env by the
# local setup script. Never check the generated value into source control.
AHP_LOCAL_TEST_PASSWORD=generate-through-local-setup

# Optional Docker Compose and synthetic collaboration acceptance inputs
POSTGRES_PASSWORD=replace-with-a-local-only-password
AHP_PROVIDER_COLLABORATION_TEST_PASSWORD=replace-with-a-local-synthetic-test-password
