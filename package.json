{
  "name": "a-health-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo dev --concurrency=32",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1 -Status",
    "dev:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1 -Stop",
    "seed:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed-local.ps1",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-local.ps1",
    "seed:staff-demo": "tsx scripts/seed-staff-demo.ts",
    "seed:provider-marketplace-test": "tsx scripts/seed-provider-marketplace-test.ts",
    "seed:provider-collaboration-test": "tsx scripts/seed-provider-collaboration-test.ts",
    "seed:digital-referral-test": "tsx scripts/seed-digital-referral-test.ts",
    "seed:provider-marketplace-test:replay": "tsx scripts/seed-provider-marketplace-test.ts --replay",
    "undo:staff-demo": "tsx scripts/seed-staff-demo.ts --undo",
    "type-check:staff-demo": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck scripts/seed-staff-demo.ts",
    "type-check:provider-collaboration-test": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck scripts/seed-provider-collaboration-test.ts",
    "type-check:digital-referral-test": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck scripts/seed-digital-referral-test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.34.4"
}
