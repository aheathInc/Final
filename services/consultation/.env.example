NODE_ENV=development
PORT=4005
DATABASE_URL=postgresql://ahealth:LOCAL_DB_PASSWORD_REQUIRED@localhost:55432/ahealth_dev?schema=public
JWT_SECRET=replace-with-at-least-32-random-local-characters
JWT_ISSUER=a-health
JWT_AUDIENCE=a-health-api

# Comma-separated ICE URLs. Use your own relay; no public service is assumed.
WEBRTC_STUN_URLS=
WEBRTC_TURN_URLS=
# Shared TURN REST authentication secret; never ship this to clients.
WEBRTC_TURN_SECRET=
