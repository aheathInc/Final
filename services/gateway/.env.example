NODE_ENV=development
PORT=4021
DATABASE_URL=postgresql://ahealth:LOCAL_DB_PASSWORD_REQUIRED@127.0.0.1:55432/ahealth_dev?schema=public
JWT_SECRET=replace-with-at-least-32-random-local-characters
JWT_ISSUER=a-health
JWT_AUDIENCE=a-health-api
GATEWAY_SHARED_SECRET=replace-with-at-least-32-random-local-characters
# Independent 32-byte key, 64 hexadecimal characters. Required in production; never reuse JWT key.
USSD_CONTEXT_KEY=
GATEWAY_INBOUND_SMS_ENABLED=false
AUTH_SERVICE_URL=http://127.0.0.1:4001
DOCTOR_SERVICE_URL=http://127.0.0.1:4003
APPOINTMENT_SERVICE_URL=http://127.0.0.1:4004
CONSULTATION_SERVICE_URL=http://127.0.0.1:4005
MESSAGING_SERVICE_URL=http://127.0.0.1:4006
FOLLOWUP_SERVICE_URL=http://127.0.0.1:4007
PAYMENT_SERVICE_URL=http://127.0.0.1:4012
USSD_SESSION_TTL_SECONDS=180
INTERNAL_TOKEN_TTL_SECONDS=120
