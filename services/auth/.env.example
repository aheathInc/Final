NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://ahealth:LOCAL_DB_PASSWORD_REQUIRED@localhost:55432/ahealth_dev?schema=public
JWT_SECRET=replace-with-at-least-32-random-local-characters
JWT_ISSUER=a-health
JWT_AUDIENCE=a-health-api
# Local-only: explicit gate plus independent OTP echo opt-in. Plaintext console logging stays off.
AUTH_LOCAL_OTP_MODE=true
OTP_ECHO_IN_RESPONSE=true
OTP_LOG_TO_CONSOLE=false

# Optional local synthetic seed inputs; required only when running the corresponding seed.
AHP_SEED_ADMIN_PASSWORD=<set-local-admin-seed-password>
AHP_SEED_CLINICIAN_PASSWORD=<set-local-clinician-seed-password>

SMS_PROVIDER=console
SMS_SENDER_ID=AHEALTH

# Direct Africa's Talking SMS integration (no live send without approved credentials).
# Choose SMS_PROVIDER=africastalking only in a configured, approved environment.
AT_ENVIRONMENT=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
# Handset delivery receipts are NOT implemented; accepted does not mean delivered.
