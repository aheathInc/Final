NODE_ENV=development
PORT=4007
DATABASE_URL=postgresql://ahealth:LOCAL_DB_PASSWORD_REQUIRED@localhost:55432/ahealth_dev?schema=public
JWT_SECRET=replace-with-at-least-32-random-local-characters
JWT_ISSUER=a-health
JWT_AUDIENCE=a-health-api

# Care Continuity. SMS defaults OFF per patient until explicit opt-in.
CARE_REMINDER_INTERVAL_SECONDS=30
CARE_REMINDER_WINDOW_MINUTES=120
CARE_REMINDER_BATCH=100
