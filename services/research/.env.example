NODE_ENV=development
PORT=4019
DATABASE_URL=postgresql://ahealth:LOCAL_DB_PASSWORD_REQUIRED@localhost:55432/ahealth_dev?schema=public
JWT_SECRET=replace-with-at-least-32-random-local-characters
JWT_ISSUER=a-health
JWT_AUDIENCE=a-health-api

# Governed research portal (disabled until migration + keys + scanner configured).
RESEARCH_PORTAL_ENABLED=false
RESEARCH_REAL_DATA_INGEST_ENABLED=false
# Independently generate 32-byte random keys; never share or reuse JWT_SECRET.
RESEARCH_ENCRYPTION_KEY=
RESEARCH_LINKAGE_KEY=
RESEARCH_CLAMD_HOST=127.0.0.1
RESEARCH_CLAMD_PORT=3310

# RC2: warehouse is opt-in and must be a separate database, never the AHP clinical database.
RESEARCH_WAREHOUSE_ENABLED=false
RESEARCH_WAREHOUSE_WORKER_ENABLED=false
RESEARCH_WAREHOUSE_DATABASE=ahealth_research
RESEARCH_WAREHOUSE_DATABASE_URL=
RESEARCH_WAREHOUSE_MAX_ROWS=50000
# Synthetic vocabulary fixture imports are forbidden in production regardless of this flag.
RESEARCH_ALLOW_SYNTHETIC_VOCABULARY=false
