NODE_ENV=development
PORT=4017
DATABASE_URL=postgresql://ahealth:LOCAL_DB_PASSWORD_REQUIRED@localhost:55432/ahealth_dev?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_LOCAL_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=a-health
JWT_AUDIENCE=a-health-api

# Synthetic integration only. Supply the value through gitignored local env or
# a secret manager. The database stores the environment-variable reference,
# never the token itself. Registration remains pending until a platform admin
# explicitly activates the system.
INTEROP_SYSTEM_TOKEN_HOSPITAL_A_EHR=<set-through-local-secret-configuration>
INTEROP_SYSTEM_TOKEN_HOSPITAL_B_EHR=<set-through-local-secret-configuration>
