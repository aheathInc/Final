# Development only. This file contains placeholders, never working credentials.
NODE_ENV=development
PORT=4012
DATABASE_URL=postgresql://ahealth:LOCAL_DB_PASSWORD_REQUIRED@127.0.0.1:55432/ahealth_dev?schema=public
JWT_SECRET=replace-with-at-least-32-random-local-characters
JWT_ISSUER=a-health
JWT_AUDIENCE=a-health-api
# console = explicitly simulated; flutterwave = native v3 Tanzania charge/verify.
MOBILE_MONEY_PROVIDER=console
FLW_ENVIRONMENT=test
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
# v3 uses verif-hash. HMAC is an explicit opt-in only for a merchant contract that supplies it.
FLW_WEBHOOK_AUTH=verif_hash
PAYMENTS_LIVE_ENABLED=false
PAYMENT_RECONCILE_SECONDS=60
INTENT_TTL_MINUTES=15
# Local simulator callbacks only; generate independent random values locally.
WEBHOOK_SECRET_MPESA=
WEBHOOK_SECRET_TIGO_PESA=
WEBHOOK_SECRET_AIRTEL_MONEY=
