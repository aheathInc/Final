openapi: 3.1.0

info:
  title: A-health Platform API
  version: 1.0.0-phase1
  summary: Contract for Phase 0 (Identity) and Phase 1 (Core Consultation).
  description: |
    Authoritative contract for the A-health platform. Frontend and backend build
    against this document in parallel; it is the single source of truth for
    request/response shapes.

    ## Conventions

    - REST over HTTPS. JSON only. Base path `/api/v1`.
    - Field naming: `snake_case` everywhere, no exceptions.
    - All timestamps are RFC 3339 / ISO 8601 in UTC with a `Z` suffix.
    - All identifiers are UUID v4 strings.
    - Every mutable resource carries `version` (integer) and `updated_at`.
      Clients send `base_version` when writing to detect conflicts.

    ## Authentication

    Bearer JWT. Access token TTL 15 minutes, refresh token TTL 30 days and
    rotated on every use. RBAC is enforced at the gateway AND re-validated in
    the service layer — never rely on the client hiding a control.

    ## State transitions

    Clinical state changes are expressed as action sub-resources
    (`POST /consultations/{id}/accept`), never as a `PATCH` on a status field.
    This pattern is applied uniformly across every resource so there is one rule
    to remember. Each action has its own permission check, its own audit entry,
    and its own set of legal source states.

    ## Idempotency

    Every POST that creates or transitions clinical state requires an
    `Idempotency-Key` header. The key is generated on the client, before the
    first send attempt, and reused across retries. The server stores the first
    response against the key for 24 hours and replays it on repeat. Without
    this, offline sync produces duplicate clinical records.

    ## Pagination

    Two modes, chosen by volatility:

    - Cursor (`cursor` + `limit`) for lists that change while being read —
      the clinician queue, message threads, sync changes.
    - Page (`page` + `page_size`) for stable lists — dependants, own history.

    ## Realtime

    WebSocket at `wss://{host}/api/v1/realtime`, authenticated with a
    short-lived ticket from `POST /realtime/token` (the browser WebSocket API
    cannot set an Authorization header). Server-pushed events:
    `consultation.assigned`, `consultation.escalated`, `consultation.message`,
    `consultation.completed`, `checkin.deviation`. Every event carries
    `entity`, `id`, `version` so the client can reconcile against local state.

    ## Care threads

    The unit of the system is the care thread, not the visit. A thread opens on
    the patient's first request for a given problem and stays open until
    recovery criteria are met. Consultations, notes, prescriptions, follow-up
    cycles and check-ins all attach to a thread. A deviation detected weeks
    after discharge reopens consultation *within the same thread*, so the
    receiving clinician sees the whole history rather than an isolated case.

    ## Two ways in

    A consultation is reached by one of two routes, and both converge on the
    same `ConsultationRequest`:

    - **On demand.** `POST /consultations` — the request enters triage, gets an
      SLA deadline, and is routed to whichever verified clinician ranks highest.
      This is the path for someone who is unwell now.
    - **Scheduled.** `POST /appointments` against a slot the clinician has
      published, then `POST /appointments/{id}/start` at the appointed time,
      which opens the consultation with the clinician already assigned. This is
      the path for chronic review, antenatal care, and anything a patient plans.

    Everything downstream — queue, consultation, note, prescription, follow-up —
    is identical regardless of route.

    ## Messaging is thread-scoped, not consultation-scoped

    Messages attach to the care thread. A consultation closing does not end the
    conversation: the promise is follow-up until recovery, so a patient must be
    able to message the clinician on day nine after a day-one discharge without
    opening a new case. `consultation_id` on a message is an optional link
    recording which consultation was open at the time, if any.

  contact:
    name: A-health Engineering
    email: architecture@a-health.org
  license:
    identifier: LicenseRef-A-health-Proprietary
    name: Proprietary — internal use only

servers:
  - url: https://api.a-health.org/api/v1
    description: Production
  - url: https://staging-api.a-health.org/api/v1
    description: Staging
  - url: http://localhost:8080/api/v1
    description: Local development

tags:
  - name: auth
    description: Registration, OTP, login, token lifecycle. Phase 0.
  - name: users
    description: Own profile and dependants. Phase 0.
  - name: clinicians
    description: Verification, availability, load. Phase 0.
  - name: care-threads
    description: The continuing unit of care. Phase 1.
  - name: appointments
    description: Scheduled bookings against a clinician's published slots. Phase 1.
  - name: consultations
    description: Consultation request lifecycle. Phase 1.
  - name: queue
    description: Clinician live queue and patient-facing queue position. Phase 1.
  - name: messages
    description: Patient/clinician conversation, thread-scoped. Phase 1.
  - name: gateway
    description: USSD and SMS aggregator webhooks. Internal. Phase 2.
  - name: follow-up
    description: Follow-up cycles, check-ins, deviation detection. Phase 3.
  - name: medications
    description: Prescriptions, dose schedule, adherence confirmation. Phase 3.
  - name: sync
    description: Offline reconciliation. Cross-cutting.
  - name: system
    description: Health checks and realtime tickets.

security:
  - bearerAuth: []

paths:

  # ----------------------------------------------------------------------
  # Phase 0 — Identity & Access
  # ----------------------------------------------------------------------

  /auth/register/patient:
    post:
      tags: [auth]
      summary: Register a patient and trigger an OTP
      description: |
        Phone number is the primary identifier. No password is set for patient
        accounts — authentication is OTP only. Returns 202 because the account
        is not usable until the OTP is verified.

        Registering an already-registered number returns 202 as well, with an
        OTP sent, so the endpoint cannot be used to enumerate which numbers
        exist on the platform.
      operationId: registerPatient
      security: []
      parameters:
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [phone_number, preferred_language]
              properties:
                phone_number:
                  $ref: '#/components/schemas/PhoneNumber'
                full_name:
                  type: string
                  maxLength: 150
                preferred_language:
                  $ref: '#/components/schemas/LanguageCode'
                channel:
                  $ref: '#/components/schemas/Channel'
      responses:
        '202':
          description: OTP dispatched
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OtpChallenge'
        '400': { $ref: '#/components/responses/BadRequest' }
        '422': { $ref: '#/components/responses/UnprocessableEntity' }
        '429': { $ref: '#/components/responses/RateLimited' }

  /auth/register/clinician:
    post:
      tags: [auth]
      summary: Register a clinician pending verification
      description: |
        Creates an account with `status = pending_verification`. The clinician
        cannot accept consultations, and no consultation note can be signed by
        them, until an admin approves the licence via
        `POST /clinicians/{clinician_id}/verification`.

        `verification_document_keys` are object-storage keys obtained from a
        prior upload; raw files are never posted to this endpoint.
      operationId: registerClinician
      security: []
      parameters:
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                [phone_number, full_name, email, license_number, specialty, preferred_language]
              properties:
                phone_number:
                  $ref: '#/components/schemas/PhoneNumber'
                full_name:
                  type: string
                  maxLength: 150
                email:
                  type: string
                  format: email
                license_number:
                  type: string
                  maxLength: 50
                specialty:
                  $ref: '#/components/schemas/Specialty'
                languages_spoken:
                  type: array
                  items:
                    $ref: '#/components/schemas/LanguageCode'
                preferred_language:
                  $ref: '#/components/schemas/LanguageCode'
                facility_id:
                  type: string
                  format: uuid
                  description: Optional. Reference only — does not grant facility privileges.
                verification_document_keys:
                  type: array
                  items: { type: string }
      responses:
        '202':
          description: Registered, verification pending, OTP dispatched
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OtpChallenge'
        '409': { $ref: '#/components/responses/Conflict' }
        '422': { $ref: '#/components/responses/UnprocessableEntity' }
        '429': { $ref: '#/components/responses/RateLimited' }

  /auth/otp/request:
    post:
      tags: [auth]
      summary: Request an OTP for an existing account
      description: |
        Rate limited per phone number and per source IP. Always returns 202
        whether or not the number is registered, to prevent enumeration.
      operationId: requestOtp
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [phone_number]
              properties:
                phone_number:
                  $ref: '#/components/schemas/PhoneNumber'
                channel:
                  $ref: '#/components/schemas/Channel'
      responses:
        '202':
          description: OTP dispatched if the account exists
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OtpChallenge'
        '429': { $ref: '#/components/responses/RateLimited' }

  /auth/otp/verify:
    post:
      tags: [auth]
      summary: Verify an OTP and issue tokens
      description: |
        Six digits, five-minute expiry, maximum five attempts per challenge.
        Exceeding the attempt limit invalidates the challenge entirely — a new
        one must be requested.
      operationId: verifyOtp
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [challenge_id, code]
              properties:
                challenge_id:
                  type: string
                  format: uuid
                code:
                  type: string
                  pattern: '^[0-9]{6}$'
                device_id:
                  type: string
                  description: Stable client-generated device identifier, for session management.
      responses:
        '200':
          description: Authenticated
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPair'
        '401': { $ref: '#/components/responses/Unauthenticated' }
        '429': { $ref: '#/components/responses/RateLimited' }

  /auth/login:
    post:
      tags: [auth]
      summary: Password login for clinician and admin roles
      description: |
        Patients never use this endpoint. If the account has MFA enabled the
        response is an MFA challenge rather than a token pair.
      operationId: login
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [email, password]
              properties:
                email:
                  type: string
                  format: email
                password:
                  type: string
                  format: password
                device_id:
                  type: string
      responses:
        '200':
          description: Authenticated, or MFA challenge issued
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: '#/components/schemas/TokenPair'
                  - $ref: '#/components/schemas/OtpChallenge'
        '401': { $ref: '#/components/responses/Unauthenticated' }
        '429': { $ref: '#/components/responses/RateLimited' }

  /auth/token/refresh:
    post:
      tags: [auth]
      summary: Rotate the refresh token and issue a new access token
      description: |
        The presented refresh token is invalidated on use. If an already-used
        refresh token is presented, the entire token family is revoked — this
        is the standard reuse-detection response to a stolen token.
      operationId: refreshToken
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [refresh_token]
              properties:
                refresh_token: { type: string }
      responses:
        '200':
          description: New token pair
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPair'
        '401': { $ref: '#/components/responses/Unauthenticated' }

  /auth/password/set:
    post:
      tags: [auth]
      summary: Set, change or reset a password
      description: |
        One endpoint for all three cases, because the rule is the same in each:
        you may set a password if you can prove either the current one or
        control of the registered phone number.

        Send `current_password` when the session came from a password login.
        Omit it when the session came from OTP verification — that already
        proved possession of the phone, and it is what makes password reset
        work without a separate emailed link.

        Every other session is revoked on success. If the password was being
        changed because of a suspected compromise, leaving the intruder's
        session alive would defeat the point.

        Not available to patient accounts, which authenticate by code only.
      operationId: setPassword
      responses:
        '204':
          description: Password set; all other sessions revoked
        '401':
          description: Not authenticated, or current password incorrect
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorEnvelope' }
        '403': { $ref: '#/components/responses/Forbidden' }
        '422': { $ref: '#/components/responses/UnprocessableEntity' }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [new_password]
              properties:
                new_password:
                  type: string
                  format: password
                  minLength: 12
                current_password:
                  type: string
                  format: password
                  description: Required unless the session was established by OTP.

  /auth/logout:
    post:
      tags: [auth]
      summary: Revoke the current session
      operationId: logout
      responses:
        '204':
          description: Session revoked
        '401': { $ref: '#/components/responses/Unauthenticated' }

  /users/me:
    get:
      tags: [users]
      summary: Get the authenticated user's profile
      operationId: getMe
      responses:
        '200':
          description: Profile
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
        '401': { $ref: '#/components/responses/Unauthenticated' }
    patch:
      tags: [users]
      summary: Update own profile
      description: |
        Non-clinical fields only. Clinical history is never edited through this
        endpoint — it is written by clinicians through consultation notes.
      operationId: updateMe
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [base_version]
              properties:
                base_version:
                  type: integer
                full_name:
                  type: string
                  maxLength: 150
                preferred_language:
                  $ref: '#/components/schemas/LanguageCode'
                default_location:
                  $ref: '#/components/schemas/GeoPoint'
                region_code:
                  type: string
                  maxLength: 20
      responses:
        '200':
          description: Updated profile
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
        '409': { $ref: '#/components/responses/Conflict' }
        '422': { $ref: '#/components/responses/UnprocessableEntity' }

  /users/me/dependents:
    get:
      tags: [users]
      summary: List dependant profiles under this guardian
      operationId: listDependents
      parameters:
        - $ref: '#/components/parameters/Page'
        - $ref: '#/components/parameters/PageSize'
      responses:
        '200':
          description: Dependants
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/PatientProfile'
                  meta:
                    $ref: '#/components/schemas/PageMeta'
    post:
      tags: [users]
      summary: Add a dependant under this guardian
      description: |
        A dependant profile has no login of its own. Consultations raised for a
        dependant are always attributed to the guardian's authenticated session
        plus the dependant's `patient_profile_id`.
      operationId: createDependent
      parameters:
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [full_name, date_of_birth, sex]
              properties:
                full_name:
                  type: string
                  maxLength: 150
                date_of_birth:
                  type: string
                  format: date
                sex:
                  $ref: '#/components/schemas/Sex'
                chronic_conditions:
                  type: array
                  items: { type: string }
                allergies:
                  type: array
                  items: { type: string }
      responses:
        '201':
          description: Dependant created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PatientProfile'
        '422': { $ref: '#/components/responses/UnprocessableEntity' }

  /clinicians:
    get:
      tags: [clinicians]
      summary: List clinicians, filtered
      description: |
        The queue an administrator works from. Approving a licence was already
        described, but there was no way to find the licences waiting for a
        decision, which made that endpoint unusable in practice.

        Admin only. Cursor paginated, because the pending list changes while it
        is being worked through.
      operationId: listClinicians
      parameters:
        - name: verification_status
          in: query
          schema:
            $ref: '#/components/schemas/VerificationStatus'
        - name: specialty
          in: query
          schema:
            $ref: '#/components/schemas/Specialty'
        - name: is_available
          in: query
          schema: { type: boolean }
        - $ref: '#/components/parameters/Cursor'
        - $ref: '#/components/parameters/Limit'
      responses:
        '200':
          description: Clinicians
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/ClinicianProfile'
                  meta:
                    $ref: '#/components/schemas/CursorMeta'
        '403': { $ref: '#/components/responses/Forbidden' }

  /clinicians/{clinician_id}:
    get:
      tags: [clinicians]
      summary: Get one clinician profile
      description: |
        Readable by an admin, or by the clinician themselves. Anyone else gets
        403 rather than 404, because the id is not a secret — what is protected
        is the record, not its existence.
      operationId: getClinician
      parameters:
        - $ref: '#/components/parameters/ClinicianId'
      responses:
        '200':
          description: Clinician profile
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ClinicianProfile'
        '403': { $ref: '#/components/responses/Forbidden' }
        '404': { $ref: '#/components/responses/NotFound' }

  /clinicians/{clinician_id}/verification:
    post:
      tags: [clinicians]
      summary: Approve or reject a clinician's licence verification
      description: |
        Admin only. Approval is what makes a clinician eligible for routing and
        for signing consultation notes. Rejection requires a reason, which is
        returned to the clinician.
      operationId: decideClinicianVerification
      parameters:
        - $ref: '#/components/parameters/ClinicianId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [decision]
              properties:
                decision:
                  type: string
                  enum: [approve, reject]
                reason:
                  type: string
                  description: Required when decision is `reject`.
      responses:
        '200':
          description: Verification recorded
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ClinicianProfile'
        '403': { $ref: '#/components/responses/Forbidden' }
        '404': { $ref: '#/components/responses/NotFound' }
        '409': { $ref: '#/components/responses/Conflict' }

  /clinicians/me/availability:
    put:
      tags: [clinicians]
      summary: Set own on-duty availability
      description: |
        Going off duty does not drop consultations already assigned — those must
        be completed or explicitly reassigned. It only removes the clinician
        from the routing candidate pool.
      operationId: setAvailability
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [is_available]
              properties:
                is_available: { type: boolean }
                until:
                  type: string
                  format: date-time
                  description: Optional auto-expiry for the availability state.
      responses:
        '200':
          description: Availability updated
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ClinicianProfile'
        '403': { $ref: '#/components/responses/Forbidden' }

  # ----------------------------------------------------------------------
  # Phase 1 — Care threads and consultations
  # ----------------------------------------------------------------------

  /care-threads:
    get:
      tags: [care-threads]
      summary: List care threads visible to the caller
      description: |
        A patient sees their own threads and those of their dependants. A
        clinician sees threads where they are the primary clinician or have an
        assigned consultation. Admins require a logged access reason.
      operationId: listCareThreads
      parameters:
        - name: patient_id
          in: query
          schema: { type: string, format: uuid }
        - name: status
          in: query
          schema:
            $ref: '#/components/schemas/CareThreadStatus'
        - $ref: '#/components/parameters/Cursor'
        - $ref: '#/components/parameters/Limit'
      responses:
        '200':
          description: Care threads
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/CareThread'
                  meta:
                    $ref: '#/components/schemas/CursorMeta'
        '403': { $ref: '#/components/responses/Forbidden' }

  /care-threads/{care_thread_id}:
    get:
      tags: [care-threads]
      summary: Get one care thread with its full timeline
      description: |
        Returns the thread plus an ordered timeline of every consultation,
        note, prescription and check-in attached to it. This is the view a
        clinician opens when a patient reappears months later.
      operationId: getCareThread
      parameters:
        - $ref: '#/components/parameters/CareThreadId'
      responses:
        '200':
          description: Care thread with timeline
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CareThreadDetail'
        '403': { $ref: '#/components/responses/Forbidden' }
        '404': { $ref: '#/components/responses/NotFound' }

  /care-threads/{care_thread_id}/close:
    post:
      tags: [care-threads]
      summary: Close a care thread
      description: |
        Clinician only, and only when no consultation on the thread is still
        open. Closing is reversible only by opening a new consultation, which
        reopens the thread automatically.
      operationId: closeCareThread
      parameters:
        - $ref: '#/components/parameters/CareThreadId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [outcome]
              properties:
                outcome:
                  type: string
                  enum: [recovered, referred_out, lost_to_follow_up, deceased]
                notes: { type: string }
      responses:
        '200':
          description: Thread closed
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CareThread'
        '403': { $ref: '#/components/responses/Forbidden' }
        '409': { $ref: '#/components/responses/Conflict' }

  /care-threads/{care_thread_id}/messages:
    get:
      tags: [messages]
      summary: List messages on a care thread
      description: |
        Cursor paginated, oldest first. Filter by `consultation_id` to show only
        the exchange that happened during one consultation; omit it to show the
        whole conversation including messages sent between consultations.
      operationId: listMessages
      parameters:
        - $ref: '#/components/parameters/CareThreadId'
        - name: consultation_id
          in: query
          schema: { type: string, format: uuid }
        - $ref: '#/components/parameters/Cursor'
        - $ref: '#/components/parameters/Limit'
      responses:
        '200':
          description: Messages
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Message'
                  meta:
                    $ref: '#/components/schemas/CursorMeta'
        '403': { $ref: '#/components/responses/Forbidden' }
    post:
      tags: [messages]
      summary: Post a message to the care thread
      description: |
        Text, or a reference to an uploaded voice note or image. The server
        attaches `consultation_id` automatically when a consultation is open.

        Delivery goes over the realtime channel to app users and is fanned out
        over SMS by the notification service for feature-phone users — the
        sender does not choose the transport.

        Permitted while the thread is open, whether or not a consultation is in
        progress. Once the thread is closed, returns 409 `CARE_THREAD_CLOSED`;
        the patient must raise a new consultation.
      operationId: createMessage
      parameters:
        - $ref: '#/components/parameters/CareThreadId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                body:
                  type: string
                  maxLength: 4000
                attachment_key: { type: string }
                attachment_type:
                  type: string
                  enum: [voice_note, image, document]
                client_created_at:
                  type: string
                  format: date-time
      responses:
        '201':
          description: Message posted
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Message'
        '403': { $ref: '#/components/responses/Forbidden' }
        '409': { $ref: '#/components/responses/Conflict' }

  /clinicians/{clinician_id}/slots:
    get:
      tags: [appointments]
      summary: List a clinician's bookable slots
      description: |
        Returns published, unbooked slots within the requested window. Slots are
        the clinician's own availability, not a hospital's room schedule — no
        facility integration is required to use this.
      operationId: listClinicianSlots
      parameters:
        - $ref: '#/components/parameters/ClinicianId'
        - name: from
          in: query
          required: true
          schema: { type: string, format: date }
        - name: to
          in: query
          required: true
          schema: { type: string, format: date }
      responses:
        '200':
          description: Available slots
          content:
            application/json:
              schema:
                type: object
                required: [data]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Slot'
        '404': { $ref: '#/components/responses/NotFound' }

  /clinicians/me/slots:
    put:
      tags: [appointments]
      summary: Publish own bookable slots for a period
      description: |
        Replaces the clinician's published slots inside the given window.
        Already-booked slots are preserved and returned in `retained`; removing
        one requires cancelling its appointment first.
      operationId: publishSlots
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [from, to, slots]
              properties:
                from: { type: string, format: date }
                to: { type: string, format: date }
                slots:
                  type: array
                  items:
                    type: object
                    required: [starts_at, duration_minutes]
                    properties:
                      starts_at: { type: string, format: date-time }
                      duration_minutes: { type: integer, minimum: 5, maximum: 120 }
                      modality:
                        $ref: '#/components/schemas/ConsultationModality'
      responses:
        '200':
          description: Slots published
          content:
            application/json:
              schema:
                type: object
                properties:
                  published:
                    type: array
                    items:
                      $ref: '#/components/schemas/Slot'
                  retained:
                    type: array
                    items:
                      $ref: '#/components/schemas/Slot'
        '403': { $ref: '#/components/responses/Forbidden' }
        '409': { $ref: '#/components/responses/Conflict' }

  /appointments:
    post:
      tags: [appointments]
      summary: Book a slot
      description: |
        Books a published slot for the patient. Slot contention is resolved by
        first write wins; losers get 409 `SLOT_UNAVAILABLE` and should refresh
        the slot list rather than retrying blindly.

        Booking does not create a consultation. The consultation opens at
        `POST /appointments/{id}/start`.
      operationId: createAppointment
      parameters:
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [slot_id]
              properties:
                slot_id: { type: string, format: uuid }
                care_thread_id:
                  type: string
                  format: uuid
                  description: Attach to an existing problem, or omit to open a new thread at start.
                patient_profile_id:
                  type: string
                  format: uuid
                  description: Required when booking for a dependant.
                reason:
                  type: string
                  maxLength: 1000
      responses:
        '201':
          description: Appointment booked
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Appointment'
        '409': { $ref: '#/components/responses/Conflict' }
        '422': { $ref: '#/components/responses/UnprocessableEntity' }
    get:
      tags: [appointments]
      summary: List appointments visible to the caller
      operationId: listAppointments
      parameters:
        - name: status
          in: query
          schema:
            $ref: '#/components/schemas/AppointmentStatus'
        - name: from
          in: query
          schema: { type: string, format: date-time }
        - name: to
          in: query
          schema: { type: string, format: date-time }
        - $ref: '#/components/parameters/Cursor'
        - $ref: '#/components/parameters/Limit'
      responses:
        '200':
          description: Appointments
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Appointment'
                  meta:
                    $ref: '#/components/schemas/CursorMeta'

  /appointments/{appointment_id}:
    get:
      tags: [appointments]
      summary: Get one appointment
      operationId: getAppointment
      parameters:
        - $ref: '#/components/parameters/AppointmentId'
      responses:
        '200':
          description: Appointment
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Appointment'
        '404': { $ref: '#/components/responses/NotFound' }

  /appointments/{appointment_id}/start:
    post:
      tags: [appointments]
      summary: Open the consultation for a booked appointment
      description: |
        Creates a `ConsultationRequest` already in `matched` state with the
        booked clinician assigned — it never enters the routing pool. Callable
        by either party from 15 minutes before `starts_at`.

        If the thread did not exist, it is opened here.
      operationId: startAppointment
      parameters:
        - $ref: '#/components/parameters/AppointmentId'
        - $ref: '#/components/parameters/IdempotencyKey'
      responses:
        '201':
          description: Consultation opened
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConsultationRequest'
        '409': { $ref: '#/components/responses/Conflict' }

  /appointments/{appointment_id}/cancel:
    post:
      tags: [appointments]
      summary: Cancel an appointment and release the slot
      operationId: cancelAppointment
      parameters:
        - $ref: '#/components/parameters/AppointmentId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: false
        content:
          application/json:
            schema:
              type: object
              properties:
                reason: { type: string, maxLength: 500 }
      responses:
        '200':
          description: Cancelled
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Appointment'
        '409': { $ref: '#/components/responses/Conflict' }

  /consultations:
    post:
      tags: [consultations]
      summary: Create a consultation request
      description: |
        The server computes `urgency_level` from the triage rules engine, sets
        `sla_deadline_at` from that level, and either attaches the request to
        the supplied `care_thread_id` or opens a new thread.

        Routing happens asynchronously. The response returns the request in
        `pending` state; assignment arrives over the realtime channel as
        `consultation.assigned`.

        `Idempotency-Key` is mandatory. Offline clients generate it at the
        moment the patient taps submit, not at the moment the network returns.
      operationId: createConsultation
      parameters:
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [channel]
              properties:
                care_thread_id:
                  type: string
                  format: uuid
                  description: Omit to open a new thread; supply to continue an existing problem.
                patient_profile_id:
                  type: string
                  format: uuid
                  description: Required when raising on behalf of a dependant.
                channel:
                  $ref: '#/components/schemas/Channel'
                symptom_text:
                  type: string
                  maxLength: 4000
                structured_symptoms:
                  type: array
                  description: Coded symptom entries consumed by the triage engine.
                  items:
                    $ref: '#/components/schemas/StructuredSymptom'
                voice_note_key:
                  type: string
                  description: Object-storage key for an uploaded voice note.
                location:
                  $ref: '#/components/schemas/GeoPoint'
                client_created_at:
                  type: string
                  format: date-time
                  description: When the patient actually submitted, which may precede arrival by hours offline.
      responses:
        '201':
          description: Consultation request created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConsultationRequest'
        '422': { $ref: '#/components/responses/UnprocessableEntity' }
        '429': { $ref: '#/components/responses/RateLimited' }
    get:
      tags: [consultations]
      summary: List consultations visible to the caller
      operationId: listConsultations
      parameters:
        - name: care_thread_id
          in: query
          schema: { type: string, format: uuid }
        - name: status
          in: query
          schema:
            $ref: '#/components/schemas/ConsultationStatus'
        - name: assigned_to_me
          in: query
          schema: { type: boolean }
        - $ref: '#/components/parameters/Cursor'
        - $ref: '#/components/parameters/Limit'
      responses:
        '200':
          description: Consultations
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/ConsultationRequest'
                  meta:
                    $ref: '#/components/schemas/CursorMeta'

  /consultations/{consultation_id}:
    get:
      tags: [consultations]
      summary: Get one consultation
      operationId: getConsultation
      parameters:
        - $ref: '#/components/parameters/ConsultationId'
      responses:
        '200':
          description: Consultation
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConsultationRequest'
        '403': { $ref: '#/components/responses/Forbidden' }
        '404': { $ref: '#/components/responses/NotFound' }

  /consultations/{consultation_id}/accept:
    post:
      tags: [consultations]
      summary: Accept a consultation from the queue
      description: |
        Legal source states: `pending`, `escalated`. Acceptance is a race — when
        a request has been broadcast to several candidates, the first accept
        wins and the rest receive 409 `CONSULTATION_ALREADY_ASSIGNED`. Clients
        must handle that as a normal outcome, not an error to surface loudly.

        Rejected if the caller is not verified.
      operationId: acceptConsultation
      parameters:
        - $ref: '#/components/parameters/ConsultationId'
        - $ref: '#/components/parameters/IdempotencyKey'
      responses:
        '200':
          description: Accepted and assigned to the caller
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConsultationRequest'
        '403': { $ref: '#/components/responses/Forbidden' }
        '409': { $ref: '#/components/responses/Conflict' }

  /consultations/{consultation_id}/decline:
    post:
      tags: [consultations]
      summary: Decline a consultation and return it to the routing pool
      description: |
        Declining does not stop the SLA clock. The routing engine immediately
        re-ranks and pushes to the next candidate.
      operationId: declineConsultation
      parameters:
        - $ref: '#/components/parameters/ConsultationId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: false
        content:
          application/json:
            schema:
              type: object
              properties:
                reason:
                  type: string
                  enum: [out_of_specialty, language_mismatch, at_capacity, other]
                note: { type: string }
      responses:
        '200':
          description: Declined and returned to pool
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConsultationRequest'
        '409': { $ref: '#/components/responses/Conflict' }

  /consultations/{consultation_id}/complete:
    post:
      tags: [consultations]
      summary: Close a consultation with a signed clinical note
      description: |
        The composite write of the system. In one atomic, idempotent call the
        clinician submits the note, an optional prescription, and an optional
        follow-up cycle. Doing this as one call rather than three is deliberate:
        over an unreliable network, three sequential writes can leave a
        consultation closed with no follow-up attached.

        The server validates that the caller is verified and is the assigned
        clinician, then stamps `signed_by_clinician_id` and `signed_at`
        server-side. Client-supplied signature fields are ignored.
      operationId: completeConsultation
      parameters:
        - $ref: '#/components/parameters/ConsultationId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [note]
              properties:
                note:
                  $ref: '#/components/schemas/ConsultationNoteInput'
                prescription:
                  $ref: '#/components/schemas/PrescriptionInput'
                follow_up_cycle:
                  $ref: '#/components/schemas/FollowUpCycleInput'
                close_care_thread:
                  type: boolean
                  default: false
                  description: Set when the problem is resolved and no follow-up is warranted.
      responses:
        '200':
          description: Consultation completed
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConsultationCompletionResult'
        '403': { $ref: '#/components/responses/Forbidden' }
        '409': { $ref: '#/components/responses/Conflict' }
        '422': { $ref: '#/components/responses/UnprocessableEntity' }

  /consultations/{consultation_id}/refer:
    post:
      tags: [consultations]
      summary: Refer to a specialist for a second opinion
      description: |
        Creates a linked consultation on the same care thread, assigned to the
        specialist pool or to a named clinician. The original consultation
        stays open until the referring clinician completes it.
      operationId: referConsultation
      parameters:
        - $ref: '#/components/parameters/ConsultationId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [specialty, reason]
              properties:
                specialty:
                  $ref: '#/components/schemas/Specialty'
                to_clinician_id:
                  type: string
                  format: uuid
                reason:
                  type: string
                  maxLength: 2000
      responses:
        '201':
          description: Referral consultation created on the same thread
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConsultationRequest'
        '403': { $ref: '#/components/responses/Forbidden' }
        '409': { $ref: '#/components/responses/Conflict' }

  /queue:
    get:
      tags: [queue]
      summary: The clinician's live queue
      description: |
        Cursor paginated, never page paginated — the queue mutates while it is
        being read, and offset pagination would skip or duplicate cases.

        Ordering is by urgency, then SLA deadline ascending. Clients should
        treat this as a backfill for the realtime stream, not as a polling
        loop: poll no more than once every 30 seconds.
      operationId: getQueue
      parameters:
        - name: scope
          in: query
          description: |
            `offered` — cases pushed to this clinician and awaiting accept.
            `mine` — cases already accepted and in progress.
          schema:
            type: string
            enum: [offered, mine]
            default: offered
        - name: urgency_level
          in: query
          schema:
            $ref: '#/components/schemas/UrgencyLevel'
        - $ref: '#/components/parameters/Cursor'
        - $ref: '#/components/parameters/Limit'
      responses:
        '200':
          description: Queue entries
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/QueueEntry'
                  meta:
                    $ref: '#/components/schemas/CursorMeta'
        '403': { $ref: '#/components/responses/Forbidden' }

  /consultations/{consultation_id}/queue-status:
    get:
      tags: [queue]
      summary: The patient's own view of where they stand
      description: |
        The counterpart to the clinician queue. A patient waiting is entitled to
        know how long — an unexplained wait is the experience the platform
        exists to remove.

        `estimated_wait_minutes` is a forecast, not a promise, and the client
        must present it as such. It is null when no reliable estimate exists,
        which is honest and better than a fabricated number.
      operationId: getQueueStatus
      parameters:
        - $ref: '#/components/parameters/ConsultationId'
      responses:
        '200':
          description: Queue status
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QueueStatus'
        '403': { $ref: '#/components/responses/Forbidden' }
        '404': { $ref: '#/components/responses/NotFound' }

  /consultations/{consultation_id}/note:
    get:
      tags: [consultations]
      summary: Retrieve the signed clinical note
      description: |
        Readable by the patient, the signing clinician, any clinician with an
        open consultation on the same thread, and admins with a logged reason.
        Every read is written to the audit log.
      operationId: getConsultationNote
      parameters:
        - $ref: '#/components/parameters/ConsultationId'
      responses:
        '200':
          description: Consultation note
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConsultationNote'
        '403': { $ref: '#/components/responses/Forbidden' }
        '404': { $ref: '#/components/responses/NotFound' }

  # ----------------------------------------------------------------------
  # Phase 3 — Follow-up and adherence
  # ----------------------------------------------------------------------

  /follow-up-cycles/{follow_up_cycle_id}:
    get:
      tags: [follow-up]
      summary: Get a follow-up cycle
      operationId: getFollowUpCycle
      parameters:
        - $ref: '#/components/parameters/FollowUpCycleId'
      responses:
        '200':
          description: Follow-up cycle
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FollowUpCycle'
        '403': { $ref: '#/components/responses/Forbidden' }
        '404': { $ref: '#/components/responses/NotFound' }

  /follow-up-cycles/{follow_up_cycle_id}/check-ins:
    get:
      tags: [follow-up]
      summary: List check-ins on a cycle
      description: |
        Includes future scheduled check-ins as well as answered ones, so the
        patient app can show what is coming and cache it for offline use.
      operationId: listCheckIns
      parameters:
        - $ref: '#/components/parameters/FollowUpCycleId'
        - name: status
          in: query
          schema:
            type: string
            enum: [scheduled, responded, missed]
        - $ref: '#/components/parameters/Cursor'
        - $ref: '#/components/parameters/Limit'
      responses:
        '200':
          description: Check-ins
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/CheckIn'
                  meta:
                    $ref: '#/components/schemas/CursorMeta'

  /check-ins/{check_in_id}/respond:
    post:
      tags: [follow-up]
      summary: Submit answers to a scheduled check-in
      description: |
        The server evaluates the answers against the cycle's `recovery_criteria`
        and sets `is_deviation` itself — the client never computes or sends it.
        A deviation raises a high-priority review task for the assigned
        clinician and pushes `checkin.deviation` over the realtime channel.

        Offline capable: answers are queued locally and replayed through
        `POST /sync/batch`.
      operationId: respondToCheckIn
      parameters:
        - $ref: '#/components/parameters/CheckInId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [responses]
              properties:
                responses:
                  type: object
                  description: Answers keyed by question id, plus any reported vitals.
                  additionalProperties: true
                channel:
                  $ref: '#/components/schemas/Channel'
                client_created_at: { type: string, format: date-time }
      responses:
        '200':
          description: Check-in recorded
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CheckIn'
        '409': { $ref: '#/components/responses/Conflict' }
        '422': { $ref: '#/components/responses/UnprocessableEntity' }

  /follow-up-cycles/{follow_up_cycle_id}/close:
    post:
      tags: [follow-up]
      summary: Close a follow-up cycle
      description: |
        Clinician only. Cycles also close automatically when recovery criteria
        are met; this endpoint is the manual override.
      operationId: closeFollowUpCycle
      parameters:
        - $ref: '#/components/parameters/FollowUpCycleId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [outcome]
              properties:
                outcome:
                  type: string
                  enum: [recovered, escalated, lost_to_follow_up]
                notes: { type: string }
      responses:
        '200':
          description: Cycle closed
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FollowUpCycle'
        '403': { $ref: '#/components/responses/Forbidden' }
        '409': { $ref: '#/components/responses/Conflict' }

  /prescriptions/{prescription_id}:
    get:
      tags: [medications]
      summary: Get a prescription with its items
      operationId: getPrescription
      parameters:
        - $ref: '#/components/parameters/PrescriptionId'
      responses:
        '200':
          description: Prescription
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Prescription'
        '403': { $ref: '#/components/responses/Forbidden' }
        '404': { $ref: '#/components/responses/NotFound' }

  /patient-profiles/{patient_profile_id}/prescriptions:
    get:
      tags: [medications]
      summary: List a patient's prescriptions
      operationId: listPatientPrescriptions
      parameters:
        - $ref: '#/components/parameters/PatientProfileId'
        - name: status
          in: query
          schema:
            type: string
            enum: [active, completed, discontinued]
        - $ref: '#/components/parameters/Cursor'
        - $ref: '#/components/parameters/Limit'
      responses:
        '200':
          description: Prescriptions
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Prescription'
                  meta:
                    $ref: '#/components/schemas/CursorMeta'
        '403': { $ref: '#/components/responses/Forbidden' }

  /adherence-logs:
    get:
      tags: [medications]
      summary: The patient's dose schedule
      description: |
        Every dose the system expects, past and upcoming, generated from the
        prescription's frequency and duration at the moment it was created.

        The client caches the coming window so the reminder still fires with no
        connectivity, and queues confirmations for replay.
      operationId: listAdherenceLogs
      parameters:
        - name: patient_profile_id
          in: query
          schema: { type: string, format: uuid }
        - name: from
          in: query
          schema: { type: string, format: date-time }
        - name: to
          in: query
          schema: { type: string, format: date-time }
        - name: reported_status
          in: query
          schema:
            $ref: '#/components/schemas/AdherenceStatus'
        - $ref: '#/components/parameters/Cursor'
        - $ref: '#/components/parameters/Limit'
      responses:
        '200':
          description: Dose schedule
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/AdherenceLog'
                  meta:
                    $ref: '#/components/schemas/CursorMeta'

  /adherence-logs/{adherence_log_id}/confirm:
    post:
      tags: [medications]
      summary: Report whether a scheduled dose was taken
      description: |
        Reachable from an app notification, an SMS reply, or a USSD menu — the
        gateway translates all three into this same call.

        Repeated missed doses on the same prescription raise a task for the
        assigned clinician. That escalation is the whole point of the feature:
        recording non-adherence without acting on it changes nothing.
      operationId: confirmAdherence
      parameters:
        - $ref: '#/components/parameters/AdherenceLogId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [reported_status]
              properties:
                reported_status:
                  $ref: '#/components/schemas/AdherenceStatus'
                channel:
                  $ref: '#/components/schemas/Channel'
                note:
                  type: string
                  maxLength: 500
                  description: Optional patient comment, e.g. why a dose was skipped.
                client_created_at: { type: string, format: date-time }
      responses:
        '200':
          description: Dose recorded
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AdherenceLog'
        '409': { $ref: '#/components/responses/Conflict' }

  # ----------------------------------------------------------------------
  # Phase 2 — Channel gateway (internal, aggregator-facing)
  # ----------------------------------------------------------------------

  /gateway/ussd/session:
    post:
      tags: [gateway]
      summary: Handle one USSD menu interaction
      description: |
        Called by the telecom aggregator on every key press. The bridge holds
        session state in Redis keyed by `session_id` and translates the
        selection into an ordinary internal API call — the same
        `POST /consultations` the app uses. There is exactly one implementation
        of the business rules, and the channel never forks it.

        Not part of the public API. Authenticated by shared secret and source-IP
        allow-list, not by JWT. Responses must fit the aggregator's session
        timeout and character limit.
      operationId: handleUssdSession
      security:
        - gatewaySignature: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [session_id, phone_number, text]
              properties:
                session_id: { type: string }
                phone_number:
                  $ref: '#/components/schemas/PhoneNumber'
                service_code: { type: string }
                text:
                  type: string
                  description: Accumulated input so far, aggregator convention.
      responses:
        '200':
          description: Menu or terminal response
          content:
            application/json:
              schema:
                type: object
                required: [response, terminate]
                properties:
                  response:
                    type: string
                    maxLength: 182
                  terminate:
                    type: boolean
                    description: True ends the USSD session.

  /gateway/sms/inbound:
    post:
      tags: [gateway]
      summary: Handle an inbound SMS keyword
      description: |
        Maps keywords to internal calls — for example a dose confirmation reply
        becomes `POST /adherence-logs/{id}/confirm`. Unrecognised text is routed
        to the patient's open care thread as a message rather than discarded.
      operationId: handleInboundSms
      security:
        - gatewaySignature: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [from, text, received_at]
              properties:
                from:
                  $ref: '#/components/schemas/PhoneNumber'
                to: { type: string }
                text: { type: string }
                received_at: { type: string, format: date-time }
                aggregator_message_id: { type: string }
      responses:
        '202':
          description: Accepted for processing
        '401': { $ref: '#/components/responses/Unauthenticated' }

  # ----------------------------------------------------------------------
  # Cross-cutting — offline sync
  # ----------------------------------------------------------------------

  /sync/changes:
    get:
      tags: [sync]
      summary: Pull everything that changed since the client last synced
      description: |
        The read half of offline support. The client stores `next_cursor` and
        presents it on the next call; the server returns every create, update
        and delete visible to the caller since that point, ordered by version.

        Deletes are returned as tombstones (`op: delete`) rather than silent
        omissions, so a client that was offline during a deletion can remove
        the local row.

        A first sync with no cursor returns a bounded snapshot of active data
        only — closed threads older than 90 days are excluded and fetched on
        demand.
      operationId: getSyncChanges
      parameters:
        - name: cursor
          in: query
          schema: { type: string }
          description: Opaque cursor from the previous sync. Omit for a first sync.
        - name: entities
          in: query
          description: Restrict to specific entity types. Defaults to all visible.
          schema:
            type: array
            items:
              $ref: '#/components/schemas/SyncEntity'
        - $ref: '#/components/parameters/Limit'
      responses:
        '200':
          description: Changes since the cursor
          content:
            application/json:
              schema:
                type: object
                required: [data, meta]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/SyncChange'
                  meta:
                    $ref: '#/components/schemas/SyncMeta'

  /sync/batch:
    post:
      tags: [sync]
      summary: Drain the client's queued offline writes
      description: |
        The write half of offline support. The client replays its local queue in
        submission order. Each operation carries its own `op_id`, which is the
        idempotency key that was generated when the user acted — so replaying
        the whole batch after a partial failure is safe.

        Operations are applied in order and independently: a failure at index 3
        does not roll back indices 0-2, and the response reports per-operation
        status so the client knows exactly which entries to drop from its queue
        and which to surface to the user.

        Only the operations listed in `SyncOperation.path` are permitted here.
        This endpoint is not a generic tunnel to the whole API.
      operationId: postSyncBatch
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [operations]
              properties:
                operations:
                  type: array
                  maxItems: 100
                  items:
                    $ref: '#/components/schemas/SyncOperation'
      responses:
        '207':
          description: Per-operation results
          content:
            application/json:
              schema:
                type: object
                required: [results]
                properties:
                  results:
                    type: array
                    items:
                      $ref: '#/components/schemas/SyncOperationResult'
        '422': { $ref: '#/components/responses/UnprocessableEntity' }

  # ----------------------------------------------------------------------
  # System
  # ----------------------------------------------------------------------

  /realtime/token:
    post:
      tags: [system]
      summary: Mint a short-lived ticket for the WebSocket handshake
      description: |
        Valid for 60 seconds, single use. Required because the browser
        WebSocket API cannot attach an Authorization header.
      operationId: createRealtimeToken
      responses:
        '201':
          description: Ticket issued
          content:
            application/json:
              schema:
                type: object
                required: [ticket, expires_at, url]
                properties:
                  ticket: { type: string }
                  expires_at: { type: string, format: date-time }
                  url: { type: string, format: uri }

  /health:
    get:
      tags: [system]
      summary: Liveness and dependency health
      description: Unauthenticated. Used by orchestration and uptime monitoring.
      operationId: getHealth
      security: []
      responses:
        '200':
          description: Healthy
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
                    enum: [ok, degraded]
                  dependencies:
                    type: object
                    additionalProperties:
                      type: string
                      enum: [ok, degraded, down]
        '503':
          description: Unhealthy

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
    gatewaySignature:
      type: apiKey
      in: header
      name: X-Gateway-Signature
      description: |
        HMAC of the raw request body using the shared aggregator secret.
        Used only on `/gateway/*`. Paired with a source-IP allow-list.

  parameters:
    IdempotencyKey:
      name: Idempotency-Key
      in: header
      required: true
      description: |
        Client-generated UUID, created at the moment the user acted. Reused
        unchanged across every retry of the same intent. The server replays the
        original response for 24 hours.
      schema:
        type: string
        format: uuid
    ConsultationId:
      name: consultation_id
      in: path
      required: true
      schema: { type: string, format: uuid }
    CareThreadId:
      name: care_thread_id
      in: path
      required: true
      schema: { type: string, format: uuid }
    ClinicianId:
      name: clinician_id
      in: path
      required: true
      schema: { type: string, format: uuid }
    AppointmentId:
      name: appointment_id
      in: path
      required: true
      schema: { type: string, format: uuid }
    FollowUpCycleId:
      name: follow_up_cycle_id
      in: path
      required: true
      schema: { type: string, format: uuid }
    CheckInId:
      name: check_in_id
      in: path
      required: true
      schema: { type: string, format: uuid }
    PrescriptionId:
      name: prescription_id
      in: path
      required: true
      schema: { type: string, format: uuid }
    AdherenceLogId:
      name: adherence_log_id
      in: path
      required: true
      schema: { type: string, format: uuid }
    PatientProfileId:
      name: patient_profile_id
      in: path
      required: true
      schema: { type: string, format: uuid }
    Cursor:
      name: cursor
      in: query
      description: Opaque cursor from the previous page's `meta.next_cursor`.
      schema: { type: string }
    Limit:
      name: limit
      in: query
      schema:
        type: integer
        minimum: 1
        maximum: 100
        default: 25
    Page:
      name: page
      in: query
      schema:
        type: integer
        minimum: 1
        default: 1
    PageSize:
      name: page_size
      in: query
      schema:
        type: integer
        minimum: 1
        maximum: 100
        default: 25

  responses:
    BadRequest:
      description: Malformed request
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorEnvelope' }
    Unauthenticated:
      description: Missing, expired, or invalid credentials
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorEnvelope' }
    Forbidden:
      description: Authenticated but not permitted
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorEnvelope' }
    NotFound:
      description: Resource does not exist or is not visible to the caller
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorEnvelope' }
    Conflict:
      description: State conflict or version mismatch
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorEnvelope' }
    UnprocessableEntity:
      description: Well-formed but semantically invalid
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorEnvelope' }
    RateLimited:
      description: Too many requests
      headers:
        Retry-After:
          schema: { type: integer }
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorEnvelope' }

  schemas:

    ErrorEnvelope:
      type: object
      required: [error]
      properties:
        error:
          type: object
          required: [code, message]
          properties:
            code:
              $ref: '#/components/schemas/ErrorCode'
            message:
              type: string
              description: Human-readable, already localised to the caller's `Accept-Language`.
            field:
              type: string
              description: Present on validation errors, naming the offending field.
            details:
              type: object
              additionalProperties: true
            request_id:
              type: string
              description: Echoes `X-Request-ID`. Quote this when reporting a problem.

    ErrorCode:
      type: string
      description: |
        Closed catalogue. Clients branch on `code`, never on `message`.
        Adding a code is a non-breaking change; removing or repurposing one is
        breaking and requires a new API version.
      enum:
        - VALIDATION_FAILED
        - UNAUTHENTICATED
        - TOKEN_EXPIRED
        - TOKEN_INVALID
        - TOKEN_REUSE_DETECTED
        - OTP_INVALID
        - OTP_EXPIRED
        - OTP_ATTEMPTS_EXCEEDED
        - FORBIDDEN
        - ROLE_NOT_PERMITTED
        - NOT_RESOURCE_OWNER
        - NOT_FOUND
        - IDEMPOTENCY_KEY_CONFLICT
        - VERSION_CONFLICT
        - STATE_TRANSITION_INVALID
        - CLINICIAN_NOT_VERIFIED
        - ACCOUNT_LOCKED
        - PASSWORD_TOO_WEAK
        - CURRENT_PASSWORD_REQUIRED
        - CURRENT_PASSWORD_INCORRECT
        - CLINICIAN_UNAVAILABLE
        - CONSULTATION_ALREADY_ASSIGNED
        - CARE_THREAD_CLOSED
        - SLOT_UNAVAILABLE
        - SLOT_IN_PAST
        - APPOINTMENT_NOT_YET_STARTABLE
        - APPOINTMENT_ALREADY_STARTED
        - CHECK_IN_ALREADY_ANSWERED
        - FOLLOW_UP_CYCLE_CLOSED
        - PRESCRIPTION_NOT_ACTIVE
        - DUPLICATE_RESOURCE
        - RATE_LIMITED
        - INTERNAL_ERROR
        - SERVICE_UNAVAILABLE

    PageMeta:
      type: object
      required: [page, page_size, total]
      properties:
        page: { type: integer }
        page_size: { type: integer }
        total: { type: integer }

    CursorMeta:
      type: object
      required: [has_more]
      properties:
        next_cursor:
          type: [string, 'null']
        has_more: { type: boolean }

    SyncMeta:
      type: object
      required: [next_cursor, has_more, server_time]
      properties:
        next_cursor: { type: string }
        has_more: { type: boolean }
        server_time:
          type: string
          format: date-time
          description: Authoritative clock. Clients with skewed device time should offset against this.

    PhoneNumber:
      type: string
      description: E.164 format, including country code.
      pattern: '^\+[1-9][0-9]{7,14}$'
      examples: ['+255712345678']

    LanguageCode:
      type: string
      description: ISO 639-1.
      enum: [sw, en, fr, ha, am]

    Channel:
      type: string
      enum: [app, sms, ussd, voice, web]

    Sex:
      type: string
      enum: [male, female, other]

    Specialty:
      type: string
      enum:
        - general_practice
        - internal_medicine
        - paediatrics
        - obstetrics_gynaecology
        - surgery
        - oncology
        - psychiatry
        - dermatology
        - other

    UrgencyLevel:
      type: string
      description: |
        Determines the SLA window: emergency 3 minutes, urgent 15 minutes,
        routine 2 hours. Values are configurable per deployment without a code
        release, but the enum itself is fixed.
      enum: [routine, urgent, emergency]

    ConsultationStatus:
      type: string
      enum: [pending, offered, matched, in_progress, completed, escalated, cancelled]

    CareThreadStatus:
      type: string
      enum: [open, closed]

    AppointmentStatus:
      type: string
      enum: [booked, started, completed, cancelled, no_show]

    ConsultationModality:
      type: string
      description: |
        `async` is store-and-forward — the clinician answers when able, without
        both parties being online. It is the default for low-bandwidth areas and
        the only modality guaranteed to work over SMS and USSD.
      enum: [chat, voice, video, async]

    AdherenceStatus:
      type: string
      enum: [taken, missed, delayed, unreported]

    UserRole:
      type: string
      enum: [patient, clinician, dispatcher, facility_admin, platform_admin]

    UserStatus:
      type: string
      enum: [active, suspended, pending_verification, deactivated]

    VerificationStatus:
      type: string
      enum: [pending, verified, rejected]

    GeoPoint:
      type: object
      required: [lat, lng]
      properties:
        lat: { type: number, format: double }
        lng: { type: number, format: double }
        accuracy_metres: { type: number }

    OtpChallenge:
      type: object
      required: [challenge_id, expires_at, delivery_channel]
      properties:
        challenge_id: { type: string, format: uuid }
        expires_at: { type: string, format: date-time }
        delivery_channel:
          $ref: '#/components/schemas/Channel'
        masked_destination:
          type: string
          description: Partially redacted destination, e.g. `+2557****5678`.
          examples: ['+2557****5678']

    TokenPair:
      type: object
      required: [access_token, refresh_token, expires_in, token_type]
      properties:
        access_token: { type: string }
        refresh_token: { type: string }
        token_type:
          type: string
          enum: [Bearer]
        expires_in:
          type: integer
          description: Access token lifetime in seconds.
          examples: [900]
        user:
          $ref: '#/components/schemas/User'

    User:
      type: object
      required: [id, role, status, preferred_language, version, updated_at]
      properties:
        id: { type: string, format: uuid }
        role:
          $ref: '#/components/schemas/UserRole'
        status:
          $ref: '#/components/schemas/UserStatus'
        full_name: { type: string }
        phone_number:
          $ref: '#/components/schemas/PhoneNumber'
        email: { type: [string, 'null'], format: email }
        preferred_language:
          $ref: '#/components/schemas/LanguageCode'
        patient_profile:
          $ref: '#/components/schemas/PatientProfile'
        clinician_profile:
          $ref: '#/components/schemas/ClinicianProfile'
        version: { type: integer }
        created_at: { type: string, format: date-time }
        updated_at: { type: string, format: date-time }

    PatientProfile:
      type: object
      required: [id, version, updated_at]
      properties:
        id: { type: string, format: uuid }
        user_id: { type: [string, 'null'], format: uuid }
        guardian_user_id:
          type: [string, 'null']
          format: uuid
          description: Set for dependant profiles that have no login of their own.
        full_name: { type: string }
        date_of_birth: { type: string, format: date }
        sex:
          $ref: '#/components/schemas/Sex'
        chronic_conditions:
          type: array
          items: { type: string }
        allergies:
          type: array
          items: { type: string }
        blood_type: { type: [string, 'null'] }
        default_location:
          $ref: '#/components/schemas/GeoPoint'
        region_code:
          type: string
          description: Used for de-identified aggregation. Never returned in analytics views alongside an id.
        version: { type: integer }
        updated_at: { type: string, format: date-time }

    ClinicianProfile:
      type: object
      required: [id, verification_status, version, updated_at]
      properties:
        id: { type: string, format: uuid }
        user_id: { type: string, format: uuid }
        facility_id: { type: [string, 'null'], format: uuid }
        license_number: { type: string }
        specialty:
          $ref: '#/components/schemas/Specialty'
        verification_status:
          $ref: '#/components/schemas/VerificationStatus'
        rejection_reason: { type: [string, 'null'] }
        languages_spoken:
          type: array
          items:
            $ref: '#/components/schemas/LanguageCode'
        is_available: { type: boolean }
        current_load:
          type: integer
          description: Count of consultations currently in progress. Read-only.
        rating_avg: { type: [number, 'null'], format: float }
        version: { type: integer }
        updated_at: { type: string, format: date-time }

    CareThread:
      type: object
      required: [id, patient_profile_id, status, opened_at, version, updated_at]
      properties:
        id: { type: string, format: uuid }
        patient_profile_id: { type: string, format: uuid }
        primary_clinician_id: { type: [string, 'null'], format: uuid }
        status:
          $ref: '#/components/schemas/CareThreadStatus'
        reason_summary:
          type: string
          description: Short clinician-authored label for the problem this thread tracks.
        latest_consultation_id: { type: [string, 'null'], format: uuid }
        open_consultation_count: { type: integer }
        active_follow_up_cycle_id: { type: [string, 'null'], format: uuid }
        opened_at: { type: string, format: date-time }
        closed_at: { type: [string, 'null'], format: date-time }
        outcome:
          type: [string, 'null']
          enum: [recovered, referred_out, lost_to_follow_up, deceased, null]
        version: { type: integer }
        updated_at: { type: string, format: date-time }

    CareThreadDetail:
      allOf:
        - $ref: '#/components/schemas/CareThread'
        - type: object
          properties:
            patient:
              $ref: '#/components/schemas/PatientProfile'
            timeline:
              type: array
              description: Chronological, oldest first.
              items:
                $ref: '#/components/schemas/TimelineEntry'

    TimelineEntry:
      type: object
      required: [entry_type, occurred_at, id]
      properties:
        entry_type:
          type: string
          enum: [consultation, note, prescription, check_in, deviation, referral, thread_closed]
        id: { type: string, format: uuid }
        occurred_at: { type: string, format: date-time }
        actor_user_id: { type: [string, 'null'], format: uuid }
        summary: { type: string }
        payload:
          type: object
          additionalProperties: true

    StructuredSymptom:
      type: object
      required: [code]
      properties:
        code:
          type: string
          description: Platform symptom code consumed by the triage rules engine.
          examples: ['chest_pain']
        severity:
          type: integer
          minimum: 0
          maximum: 10
        duration_hours: { type: number }

    ConsultationRequest:
      type: object
      required: [id, care_thread_id, patient_profile_id, status, urgency_level, channel, created_at, version, updated_at]
      properties:
        id: { type: string, format: uuid }
        care_thread_id: { type: string, format: uuid }
        patient_profile_id: { type: string, format: uuid }
        assigned_clinician_id: { type: [string, 'null'], format: uuid }
        referred_from_consultation_id: { type: [string, 'null'], format: uuid }
        appointment_id:
          type: [string, 'null']
          format: uuid
          description: Set when this consultation came from a booked appointment rather than the queue.
        modality:
          $ref: '#/components/schemas/ConsultationModality'
        queue_position:
          type: [integer, 'null']
          description: Position while `pending` or `offered`. Null once assigned.
        estimated_wait_minutes:
          type: [integer, 'null']
          description: Forecast, not a commitment. Null when no reliable estimate exists.
        channel:
          $ref: '#/components/schemas/Channel'
        symptom_text: { type: [string, 'null'] }
        structured_symptoms:
          type: array
          items:
            $ref: '#/components/schemas/StructuredSymptom'
        voice_note_key: { type: [string, 'null'] }
        urgency_level:
          $ref: '#/components/schemas/UrgencyLevel'
        triage_rule_version:
          type: string
          description: |
            Exact version of the rule set that produced `urgency_level`. Stored
            for clinical audit — a triage decision must always be explainable
            against the rules that were live at the time.
        status:
          $ref: '#/components/schemas/ConsultationStatus'
        sla_deadline_at: { type: string, format: date-time }
        escalation_count: { type: integer }
        created_at: { type: string, format: date-time }
        client_created_at: { type: [string, 'null'], format: date-time }
        accepted_at: { type: [string, 'null'], format: date-time }
        completed_at: { type: [string, 'null'], format: date-time }
        version: { type: integer }
        updated_at: { type: string, format: date-time }

    QueueEntry:
      type: object
      required: [consultation, offered_at]
      properties:
        consultation:
          $ref: '#/components/schemas/ConsultationRequest'
        patient_summary:
          type: object
          description: |
            Minimum necessary to decide whether to accept — age band, sex,
            language, flagged chronic conditions. Full history is only readable
            after acceptance.
          properties:
            age_band: { type: string, examples: ['30-39'] }
            sex:
              $ref: '#/components/schemas/Sex'
            preferred_language:
              $ref: '#/components/schemas/LanguageCode'
            has_chronic_conditions: { type: boolean }
        offered_at: { type: string, format: date-time }
        seconds_to_sla_breach: { type: integer }
        rank_score: { type: number, format: float }

    Message:
      type: object
      required: [id, care_thread_id, sender_user_id, created_at, version]
      properties:
        id: { type: string, format: uuid }
        care_thread_id: { type: string, format: uuid }
        consultation_id:
          type: [string, 'null']
          format: uuid
          description: |
            Which consultation was open when this was sent. Null for messages
            exchanged between consultations — during follow-up, for example.
        sender_user_id: { type: string, format: uuid }
        body: { type: [string, 'null'] }
        attachment_key: { type: [string, 'null'] }
        attachment_type:
          type: [string, 'null']
          enum: [voice_note, image, document, null]
        delivered_via:
          $ref: '#/components/schemas/Channel'
        created_at: { type: string, format: date-time }
        client_created_at: { type: [string, 'null'], format: date-time }
        version: { type: integer }

    Slot:
      type: object
      required: [id, clinician_id, starts_at, duration_minutes, is_booked]
      properties:
        id: { type: string, format: uuid }
        clinician_id: { type: string, format: uuid }
        starts_at: { type: string, format: date-time }
        duration_minutes: { type: integer }
        modality:
          $ref: '#/components/schemas/ConsultationModality'
        is_booked: { type: boolean }

    Appointment:
      type: object
      required: [id, slot_id, patient_profile_id, clinician_id, starts_at, status, version, updated_at]
      properties:
        id: { type: string, format: uuid }
        slot_id: { type: string, format: uuid }
        care_thread_id: { type: [string, 'null'], format: uuid }
        patient_profile_id: { type: string, format: uuid }
        clinician_id: { type: string, format: uuid }
        consultation_id:
          type: [string, 'null']
          format: uuid
          description: Set once the appointment has been started.
        starts_at: { type: string, format: date-time }
        duration_minutes: { type: integer }
        modality:
          $ref: '#/components/schemas/ConsultationModality'
        reason: { type: [string, 'null'] }
        status:
          $ref: '#/components/schemas/AppointmentStatus'
        cancelled_reason: { type: [string, 'null'] }
        version: { type: integer }
        created_at: { type: string, format: date-time }
        updated_at: { type: string, format: date-time }

    QueueStatus:
      type: object
      required: [consultation_id, status, urgency_level]
      properties:
        consultation_id: { type: string, format: uuid }
        status:
          $ref: '#/components/schemas/ConsultationStatus'
        urgency_level:
          $ref: '#/components/schemas/UrgencyLevel'
        queue_position: { type: [integer, 'null'] }
        ahead_of_you: { type: [integer, 'null'] }
        estimated_wait_minutes: { type: [integer, 'null'] }
        sla_deadline_at: { type: string, format: date-time }
        assigned_clinician:
          type: [object, 'null']
          description: Present once assigned. Deliberately minimal.
          properties:
            full_name: { type: string }
            specialty:
              $ref: '#/components/schemas/Specialty'

    ConsultationNote:
      type: object
      required: [id, consultation_id, care_thread_id, signed_by_clinician_id, signed_at, version]
      properties:
        id: { type: string, format: uuid }
        consultation_id: { type: string, format: uuid }
        care_thread_id: { type: string, format: uuid }
        diagnosis_text: { type: string }
        diagnosis_codes:
          type: array
          items: { type: string }
        advice_text: { type: string }
        red_flags_discussed:
          type: array
          items: { type: string }
        referred_specialist_id: { type: [string, 'null'], format: uuid }
        signed_by_clinician_id: { type: string, format: uuid }
        signed_at: { type: string, format: date-time }
        version: { type: integer }

    FollowUpCycle:
      type: object
      required: [id, care_thread_id, patient_profile_id, clinician_id, status, version, updated_at]
      properties:
        id: { type: string, format: uuid }
        care_thread_id: { type: string, format: uuid }
        patient_profile_id: { type: string, format: uuid }
        clinician_id: { type: string, format: uuid }
        source_consultation_id: { type: string, format: uuid }
        frequency:
          type: string
          enum: [daily, twice_daily, weekly, custom]
        custom_cron: { type: [string, 'null'] }
        questionnaire_key: { type: [string, 'null'] }
        recovery_criteria:
          type: object
          additionalProperties: true
        start_date: { type: string, format: date }
        end_date: { type: string, format: date }
        status:
          type: string
          enum: [active, completed, cancelled]
        outcome:
          type: [string, 'null']
          enum: [recovered, escalated, lost_to_follow_up, null]
        open_deviation_count: { type: integer }
        version: { type: integer }
        updated_at: { type: string, format: date-time }

    CheckIn:
      type: object
      required: [id, follow_up_cycle_id, scheduled_at, status, version, updated_at]
      properties:
        id: { type: string, format: uuid }
        follow_up_cycle_id: { type: string, format: uuid }
        care_thread_id: { type: string, format: uuid }
        scheduled_at: { type: string, format: date-time }
        status:
          type: string
          enum: [scheduled, responded, missed]
        questions:
          type: array
          description: Rendered question set, cached by the client for offline answering.
          items:
            type: object
            additionalProperties: true
        responses:
          type: [object, 'null']
          additionalProperties: true
        is_deviation:
          type: boolean
          description: Computed server-side against `recovery_criteria`. Never client-supplied.
        deviation_reasons:
          type: array
          items: { type: string }
        reviewed_by_id: { type: [string, 'null'], format: uuid }
        reviewed_at: { type: [string, 'null'], format: date-time }
        responded_at: { type: [string, 'null'], format: date-time }
        channel:
          $ref: '#/components/schemas/Channel'
        version: { type: integer }
        updated_at: { type: string, format: date-time }

    Prescription:
      type: object
      required: [id, care_thread_id, patient_profile_id, prescribed_by_id, status, items, version, updated_at]
      properties:
        id: { type: string, format: uuid }
        care_thread_id: { type: string, format: uuid }
        consultation_id: { type: string, format: uuid }
        patient_profile_id: { type: string, format: uuid }
        prescribed_by_id: { type: string, format: uuid }
        status:
          type: string
          enum: [active, completed, discontinued]
        items:
          type: array
          items:
            $ref: '#/components/schemas/PrescriptionItem'
        adherence_rate:
          type: [number, 'null']
          format: float
          description: Confirmed doses over expected doses to date, 0-1.
        version: { type: integer }
        created_at: { type: string, format: date-time }
        updated_at: { type: string, format: date-time }

    PrescriptionItem:
      type: object
      required: [id, medication_name, dosage, frequency_per_day, duration_days]
      properties:
        id: { type: string, format: uuid }
        medication_name: { type: string }
        dosage: { type: string }
        frequency_per_day: { type: integer }
        duration_days: { type: integer }
        instructions: { type: [string, 'null'] }

    AdherenceLog:
      type: object
      required: [id, prescription_item_id, scheduled_at, reported_status, version, updated_at]
      properties:
        id: { type: string, format: uuid }
        prescription_item_id: { type: string, format: uuid }
        prescription_id: { type: string, format: uuid }
        patient_profile_id: { type: string, format: uuid }
        medication_name:
          type: string
          description: Denormalised so a reminder can render without a second fetch.
        dosage: { type: string }
        scheduled_at: { type: string, format: date-time }
        reported_status:
          $ref: '#/components/schemas/AdherenceStatus'
        reported_at: { type: [string, 'null'], format: date-time }
        note: { type: [string, 'null'] }
        channel:
          $ref: '#/components/schemas/Channel'
        version: { type: integer }
        updated_at: { type: string, format: date-time }

    ConsultationNoteInput:
      type: object
      required: [diagnosis_text, advice_text]
      properties:
        diagnosis_text:
          type: string
          maxLength: 4000
        diagnosis_codes:
          type: array
          description: ICD-10 codes where the clinician can supply them.
          items: { type: string }
        advice_text:
          type: string
          maxLength: 4000
        red_flags_discussed:
          type: array
          description: Warning signs the patient was told to watch for.
          items: { type: string }

    PrescriptionInput:
      type: object
      required: [items]
      properties:
        items:
          type: array
          minItems: 1
          items:
            type: object
            required: [medication_name, dosage, frequency_per_day, duration_days]
            properties:
              medication_name: { type: string, maxLength: 150 }
              dosage: { type: string, examples: ['500mg'] }
              frequency_per_day: { type: integer, minimum: 1, maximum: 12 }
              duration_days: { type: integer, minimum: 1, maximum: 365 }
              instructions: { type: string }

    FollowUpCycleInput:
      type: object
      required: [frequency, duration_days]
      properties:
        frequency:
          type: string
          enum: [daily, twice_daily, weekly, custom]
        custom_cron:
          type: string
          description: Required when `frequency` is `custom`.
        duration_days: { type: integer, minimum: 1, maximum: 365 }
        questionnaire_key:
          type: string
          description: Which check-in questionnaire to send at each interval.
        recovery_criteria:
          type: object
          description: |
            Clinician-set thresholds. A check-in response outside these bounds
            is flagged `is_deviation` and raises a high-priority review task.
          additionalProperties: true

    ConsultationCompletionResult:
      type: object
      required: [consultation, note]
      properties:
        consultation:
          $ref: '#/components/schemas/ConsultationRequest'
        note:
          type: object
          properties:
            id: { type: string, format: uuid }
            signed_by_clinician_id: { type: string, format: uuid }
            signed_at: { type: string, format: date-time }
        prescription_id: { type: [string, 'null'], format: uuid }
        follow_up_cycle_id: { type: [string, 'null'], format: uuid }
        care_thread:
          $ref: '#/components/schemas/CareThread'

    SyncEntity:
      type: string
      enum:
        - care_threads
        - appointments
        - consultation_requests
        - consultation_notes
        - messages
        - prescriptions
        - prescription_items
        - adherence_logs
        - follow_up_cycles
        - check_ins
        - patient_profiles

    SyncChange:
      type: object
      required: [entity, id, op, version, updated_at]
      properties:
        entity:
          $ref: '#/components/schemas/SyncEntity'
        id: { type: string, format: uuid }
        op:
          type: string
          enum: [create, update, delete]
        version: { type: integer }
        updated_at: { type: string, format: date-time }
        data:
          type: object
          description: Full resource body. Absent when `op` is `delete`.
          additionalProperties: true

    SyncOperation:
      type: object
      required: [op_id, method, path]
      properties:
        op_id:
          type: string
          format: uuid
          description: Generated when the user acted. Doubles as the idempotency key.
        method:
          type: string
          enum: [POST, PATCH]
        path:
          type: string
          description: |
            Relative path of the operation being replayed. Restricted to the
            whitelist of offline-capable writes — every entry here is a path
            defined elsewhere in this document.
          enum:
            - /consultations
            - /care-threads/{care_thread_id}/messages
            - /consultations/{consultation_id}/complete
            - /check-ins/{check_in_id}/respond
            - /adherence-logs/{adherence_log_id}/confirm
            - /appointments
            - /appointments/{appointment_id}/cancel
        path_params:
          type: object
          additionalProperties: { type: string }
        base_version:
          type: integer
          description: Version the client believed it was writing against, where applicable.
        body:
          type: object
          additionalProperties: true
        client_created_at: { type: string, format: date-time }

    SyncOperationResult:
      type: object
      required: [op_id, status]
      properties:
        op_id: { type: string, format: uuid }
        status:
          type: integer
          description: The HTTP status the operation would have returned individually.
        body:
          type: object
          additionalProperties: true
        error:
          $ref: '#/components/schemas/ErrorEnvelope'
